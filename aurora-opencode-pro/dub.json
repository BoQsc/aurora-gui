{
  "name": "aurora-opencode-pro",
  "description": "Extended Aurora OpenCode desktop chat client built on the shared aurora-opencode-core package",
  "authors": [
    "OpenAI"
  ],
  "copyright": "Copyright \u00a9 2026 OpenAI",
  "license": "BSL-1.0",
  "targetType": "executable",
  "targetName": "aurora-opencode-pro",
  "mainSourceFile": "source/app.d",
  "sourcePaths": [
    "source",
    "../vendor/aurora-d-0.4.5/source"
  ],
  "stringImportPaths": [
    "assets"
  ],
  "dependencies": {
    "aurora-opencode-core": {
      "path": "../aurora-opencode-core"
    }
  },
  "configurations": [
    {
      "name": "application",
      "targetType": "executable",
      "targetName": "aurora-opencode-pro",
      "mainSourceFile": "source/app.d",
      "postBuildCommands-windows": [
        "cmd /c tools\\embed-icon.bat"
      ]
    },
    {
      "name": "newbuild",
      "targetType": "executable",
      "targetName": "aurora-opencode-pro-new",
      "mainSourceFile": "source/app.d",
      "postBuildCommands-windows": [
        "cmd /c tools\\embed-icon.bat"
      ]
    },
    {
      "name": "rebuilder",
      "targetType": "executable",
      "targetName": "aurora-rebuilder",
      "mainSourceFile": "tools/rebuilder.d",
      "sourcePaths": [
        "tools"
      ],
      "excludedSourceFiles": [
        "source/**"
      ],
      "targetPath": "bin",
      "lflags-windows": [
        "/SUBSYSTEM:CONSOLE"
      ]
    },
    {
      "name": "cli",
      "targetType": "executable",
      "targetName": "aurora-cli",
      "mainSourceFile": "tools/aurora-cli.d",
      "sourcePaths": [
        "tools"
      ],
      "targetPath": "bin",
      "libs-windows": [
        "user32",
        "gdi32"
      ],
      "lflags-windows": [
        "/SUBSYSTEM:CONSOLE"
      ]
    }
  ],
  "libs-windows": [
    "user32",
    "gdi32",
    "shell32",
    "wininet"
  ],
  "buildTypes": {
    "release": {
      "buildOptions": [
        "releaseMode",
        "optimize",
        "inline",
        "debugInfo"
      ]
    },
    "portable-release": {
      "buildOptions": [
        "releaseMode",
        "optimize",
        "inline",
        "debugInfo"
      ],
      "dflags-windows-dmd": [
        "-mscrtlib=libcmt"
      ],
      "dflags-windows-ldc": [
        "-mscrtlib=libcmt"
      ]
    }
  },
  "lflags-windows": [
    "/SUBSYSTEM:WINDOWS",
    "/ENTRY:mainCRTStartup"
  ],
  "libs-linux": [
    "X11",
    "dl"
  ],
  "lflags-osx": [
    "-framework",
    "AppKit",
    "-framework",
    "CoreGraphics",
    "-framework",
    "CoreFoundation",
    "-framework",
    "QuartzCore",
    "-lobjc"
  ],
  "version": "0.66.9"
}
