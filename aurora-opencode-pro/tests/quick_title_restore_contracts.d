module quick_title_restore_contracts;

// Regression: a conversation whose name rewrite was lost to a restart still
// gets named on the next launch.
//
// `titlePending` is in memory only. A rebuild or a crash during a new chat's
// opening turn therefore stranded `chatTitle(firstMessage)` as the permanent
// name - exactly the "names still are not generated by agent" report from users
// who rebuild while a new chat works. On restore the app must re-queue the
// rewrite for an opening turn whose title is still the raw placeholder, and
// must leave an already-generated name alone.

import aurora;
import auroraopencode.appui : OpenCodeRoot;
import auroraopencode.core : Settings, saveSettings, opencodeTheme,
    setOpencodeStateDirectoryForTesting;
import core.thread : Thread;
import core.time : MonoTime, msecs, seconds;
import std.conv : to;
import std.file : mkdirRecurse, write;
import std.json : JSONValue;
import std.path : buildPath, absolutePath;
import std.process : environment;
import std.stdio : writeln;

int main()
{
    const base = environment.get("AURORA_CONTRACT_PROVIDER_BASE", "");
    assert(base.length, "Run with tests/test_quick_title_restore.py");
    const directory = absolutePath(
        "quick-title-restore-" ~ to!string(MonoTime.currTime.ticks));
    const workspace = buildPath(directory, "workspace");
    const state = buildPath(directory, "state");
    mkdirRecurse(workspace);
    mkdirRecurse(buildPath(state, "threads"));

    // The long opening prompt whose raw truncation the user saw as a name.
    const promptText =
        "Investigate and fix an issue in Aurora OpenCode. Its program source " ~
        "is at C:/somewhere/aurora-opencode-pro  What is wrong: the new " ~
        "conversations names still do not get generated by agent";
    const rawTitle = promptText[0 .. 60] ~ "…";

    JSONValue index;
    index["version"] = 2;
    index["current"] = 0;
    index["currentId"] = "stranded-chat";
    JSONValue stranded;
    stranded["id"] = "stranded-chat";
    stranded["title"] = rawTitle;
    stranded["activeLeaf"] = "prompt-1";
    stranded["turnStatus"] = "interrupted";
    JSONValue named;
    named["id"] = "named-chat";
    named["title"] = "Already generated name";
    named["activeLeaf"] = "prompt-2";
    named["turnStatus"] = "completed";
    // A chat that ran to completion before the fix existed keeps the same raw
    // placeholder; it must be healed too, not only an interrupted opening turn.
    JSONValue finishedRaw;
    finishedRaw["id"] = "finished-raw";
    finishedRaw["title"] = rawTitle;
    finishedRaw["activeLeaf"] = "reply-3";
    finishedRaw["turnStatus"] = "completed";
    index["sessions"] = [stranded, named, finishedRaw];
    write(buildPath(state, "threads.index.json"), index.toString());

    JSONValue strandedThread;
    JSONValue strandedPrompt;
    strandedPrompt["id"] = "prompt-1";
    strandedPrompt["role"] = "user";
    strandedPrompt["content"] = promptText;
    strandedThread["messages"] = [strandedPrompt];
    write(buildPath(state, "threads", "stranded-chat.json"),
        strandedThread.toString());

    JSONValue namedThread;
    JSONValue namedPrompt;
    namedPrompt["id"] = "prompt-2";
    namedPrompt["role"] = "user";
    namedPrompt["content"] = "An unrelated short request";
    JSONValue namedReply;
    namedReply["id"] = "reply-2";
    namedReply["parentId"] = "prompt-2";
    namedReply["role"] = "assistant";
    namedReply["content"] = "Done";
    namedThread["messages"] = [namedPrompt, namedReply];
    write(buildPath(state, "threads", "named-chat.json"),
        namedThread.toString());

    JSONValue finishedThread;
    JSONValue finishedPrompt;
    finishedPrompt["id"] = "prompt-3";
    finishedPrompt["role"] = "user";
    finishedPrompt["content"] = promptText;
    JSONValue finishedReply;
    finishedReply["id"] = "reply-3";
    finishedReply["parentId"] = "prompt-3";
    finishedReply["role"] = "assistant";
    finishedReply["content"] = "Investigated and fixed.";
    finishedThread["messages"] = [finishedPrompt, finishedReply];
    write(buildPath(state, "threads", "finished-raw.json"),
        finishedThread.toString());

    // A restart left a resume note, as a rebuild does.
    JSONValue note;
    note["cause"] = "rebuild";
    write(buildPath(state, "restart-resume.json"), note.toString());

    setOpencodeStateDirectoryForTesting(state);
    Settings settings;
    settings.baseUrl = base;
    settings.apiKey = "local-fixture";
    settings.model = "fixture";
    settings.workspace = workspace;
    settings.toolsEnabled = false;
    settings.legacyTools = false;
    settings.quickTitle = true;
    saveSettings(settings);
    WindowOptions options;
    options.width = 1200;
    options.height = 800;
    options.renderer = RendererPreference.software;
    auto window = new GuiWindow(options, opencodeTheme());
    auto root = new OpenCodeRoot(window);
    window.setRoot(root);
    scope(exit) root.shutdownClient();
    const ready = MonoTime.currTime + 5.seconds;
    while (root.startupPendingForTesting() && MonoTime.currTime < ready)
    {
        window.onNativeTick(0.02);
        Thread.sleep(5.msecs);
    }

    const strandedIndex = root.sessionIndexForTesting("stranded-chat");
    assert(strandedIndex >= 0, "the stranded conversation was not restored");
    assert(root.sessionTitleForTesting(strandedIndex) == rawTitle,
        "the fixture did not start from the stranded raw title; title='" ~
        root.sessionTitleForTesting(strandedIndex) ~ "'");

    // Startup already ran the restore path; the lost rewrite must be re-queued.
    const deadline = MonoTime.currTime + 15.seconds;
    while (root.sessionTitleForTesting(strandedIndex) != "Fixture" &&
        MonoTime.currTime < deadline)
    {
        window.onNativeTick(0.02);
        Thread.sleep(5.msecs);
    }
    assert(root.sessionTitleForTesting(strandedIndex) == "Fixture",
        "the rewrite lost to a restart was never re-queued; title='" ~
        root.sessionTitleForTesting(strandedIndex) ~ "'");

    // A conversation the model already named must be left untouched.
    const namedIndex = root.sessionIndexForTesting("named-chat");
    assert(namedIndex >= 0, "the already-named conversation was not restored");
    assert(root.sessionTitleForTesting(namedIndex) == "Already generated name",
        "recovery overwrote an already-generated name; title='" ~
        root.sessionTitleForTesting(namedIndex) ~ "'");

    // A chat that finished its work long ago but kept the raw placeholder is
    // healed as well.
    const finishedIndex = root.sessionIndexForTesting("finished-raw");
    assert(finishedIndex >= 0, "the finished conversation was not restored");
    const finishedDeadline = MonoTime.currTime + 15.seconds;
    while (root.sessionTitleForTesting(finishedIndex) != "Fixture" &&
        MonoTime.currTime < finishedDeadline)
    {
        window.onNativeTick(0.02);
        Thread.sleep(5.msecs);
    }
    assert(root.sessionTitleForTesting(finishedIndex) == "Fixture",
        "a finished chat left with the raw placeholder was never healed; title='" ~
        root.sessionTitleForTesting(finishedIndex) ~ "'");
    writeln("PASS a rewrite lost to a restart is re-queued without touching a " ~
        "generated name");
    return 0;
}
