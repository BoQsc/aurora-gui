{
  "inputs": [
    "aurora-opencode-pro/tests/computer_progress_test.d",
    "aurora-opencode-pro/source/auroraopencode/requestintent.d"
  ],
  "steps": [
    {
      "kind": "compile",
      "command": {
        "program": "dmd",
        "args": [
          "-i",
          "-verrors=20",
          "-Isource",
          "-Ishared",
          "-I../aurora-opencode-core/source",
          "-I../vendor/aurora-d-0.4.5/source",
          "-Jassets",
          "tests/computer_progress_test.d",
          "user32.lib",
          "gdi32.lib",
          "shell32.lib",
          "wininet.lib",
          "winmm.lib",
          "-ofbuild/why-action-test.exe"
        ],
        "workdir": "aurora-opencode-pro",
        "timeout": 300000
      }
    },
    {
      "kind": "tests",
      "command": {
        "program": "build/why-action-test.exe",
        "args": [],
        "workdir": "aurora-opencode-pro",
        "timeout": 120000
      }
    }
  ]
}
