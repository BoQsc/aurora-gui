{
  "inputs": [
    "aurora-opencode-pro/source/auroraopencode/appui.d",
    "aurora-opencode-pro/source/auroraopencode/systemprompt.d",
    "aurora-opencode-pro/tests/early_plan_contracts.d",
    "aurora-opencode-pro/tests/tool_feedback_ui_contracts.d",
    "aurora-opencode-pro/tests/plan_upkeep_check.py"
  ],
  "steps": [
    {
      "kind": "compile",
      "command": {
        "program": "dmd",
        "args": [
          "-o-", "-i", "-verrors=20",
          "-Isource", "-Ishared", "-Itests",
          "-I../aurora-opencode-core/source",
          "-I../vendor/aurora-d-0.4.5/source",
          "-Jassets",
          "tests/tool_feedback_ui_contracts.d"
        ],
        "workdir": "aurora-opencode-pro",
        "timeout": 600000
      }
    },
    {
      "kind": "tests",
      "command": {
        "program": "python",
        "args": ["-u", "-B", "tests/plan_upkeep_check.py"],
        "workdir": "aurora-opencode-pro",
        "timeout": 1200000
      }
    }
  ]
}
