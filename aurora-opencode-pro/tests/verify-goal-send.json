          "-i",
          "-verrors=20",
          "-Isource",
          "-Ishared",
          "-I../aurora-opencode-core/source",
          "-I../vendor/aurora-d-0.4.5/source",
          "-Jassets",
          "tests/goal_ui_smoke.d",
          "user32.lib",
          "gdi32.lib",
          "shell32.lib",
          "wininet.lib",
          "winmm.lib",
          "-ofbuild/goal-send-check/goal_ui_smoke.exe"
        ],
        "workdir": "aurora-opencode-pro",
        "timeout": 900000
      }
    },
    {
      "kind": "tests",
      "command": {
        "program": "build/goal-send-check/goal_ui_smoke.exe",
        "args": [],
        "workdir": "aurora-opencode-pro",
        "timeout": 180000
      }
    },
    {
      "kind": "compile",
      "command": {
        "program": "dmd",
        "args": [
          "-i",
          "-verrors=20",
          "-Isource",
          "-Ishared",
          "-I../aurora-opencode-core/source",
          "-I../vendor/aurora-d-0.4.5/source",
          "-Jassets",
          "tests/goal_mode_contracts.d",
          "user32.lib",
          "gdi32.lib",
          "shell32.lib",
          "wininet.lib",
          "winmm.lib",
          "-ofbuild/goal-send-check/goal_mode_contracts.exe"
        ],
        "workdir": "aurora-opencode-pro",
        "timeout": 900000
      }
    },
    {
