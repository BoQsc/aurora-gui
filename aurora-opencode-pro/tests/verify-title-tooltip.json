{
  "inputs": [
    "aurora-opencode-pro/tests/headless_pro_smoke.d",
    "aurora-opencode-pro/source/auroraopencode/appui.d",
    "vendor/aurora-d-0.4.5/source/aurora/widgets/listview.d",
    "vendor/aurora-d-0.4.5/source/aurora/window.d",
    "vendor/aurora-d-0.4.5/source/aurora/platform/win32.d",
    "vendor/aurora-d-0.4.5/source/aurora/testing.d"
  ],
  "steps": [
    {
      "kind": "compile",
      "command": {
        "program": "dmd",
        "args": [
          "-version=AuroraHeadless",
          "-i",
          "-verrors=20",
          "-Isource",
          "-Ishared",
          "-I../aurora-opencode-core/source",
          "-I../vendor/aurora-d-0.4.5/source",
          "-Jassets",
          "tests/headless_pro_smoke.d",
          "user32.lib",
          "gdi32.lib",
          "shell32.lib",
          "wininet.lib",
          "winmm.lib",
          "-ofbuild/headless-pro-smoke.exe"
        ],
        "workdir": "aurora-opencode-pro",
        "timeout": 300000
      }
    },
    {
      "kind": "tests",
      "command": {
        "program": "build/headless-pro-smoke.exe",
        "args": ["--title-tooltip-only"],
        "workdir": "aurora-opencode-pro",
        "timeout": 120000
      }
    }
  ]
}
