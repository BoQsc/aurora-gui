{
  "inputs": [
    "aurora-opencode-pro/source/auroraopencode/appui.d",
    "aurora-opencode-pro/source/auroraopencode/transcriptpresenter.d",
    "aurora-opencode-pro/tests/transcript_scroll_follow_contracts.d",
    "aurora-opencode-core/source/auroraopencode/core.d"
  ],
  "steps": [
    {
      "kind": "compile",
      "command": {
        "program": "dmd",
        "args": [
          "-i",
          "-lowmem",
          "-verrors=20",
          "-Isource",
          "-Ishared",
          "-I../aurora-opencode-core/source",
          "-I../vendor/aurora-d-0.4.5/source",
          "-Jassets",
          "tests/transcript_scroll_follow_contracts.d",
          "user32.lib",
          "gdi32.lib",
          "shell32.lib",
          "wininet.lib",
          "winmm.lib",
          "-of=build/transcript-scroll-follow/transcript_scroll_follow_contracts.exe"
        ],
        "workdir": "aurora-opencode-pro",
        "timeout": 600000
      }
    },
    {
      "kind": "tests",
      "command": {
        "program": "build/transcript-scroll-follow/transcript_scroll_follow_contracts.exe",
        "args": [],
        "workdir": "aurora-opencode-pro",
        "timeout": 180000
      }
    }
  ]
}
