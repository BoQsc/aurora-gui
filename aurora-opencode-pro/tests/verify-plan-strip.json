{
  "inputs": [
    "aurora-opencode-pro/source/auroraopencode/appui.d",
    "aurora-opencode-core/source/auroraopencode/core.d",
    "aurora-opencode-pro/tests/plan_strip_contracts.d",
    "aurora-opencode-pro/tests/crop_ppm.py"
  ],
  "steps": [
    {
      "kind": "compile",
      "command": {
        "program": "dmd",
        "args": [
          "-i", "-verrors=20", "-Isource", "-Ishared",
          "-I../aurora-opencode-core/source", "-I../vendor/aurora-d-0.4.5/source",
          "-Jassets", "tests/plan_strip_contracts.d",
          "user32.lib", "gdi32.lib", "shell32.lib", "wininet.lib", "winmm.lib",
          "-of=C:\\Users\\windows10\\AppData\\Local\\Temp\\aurora-plan-strip-verify\\plan_strip_contracts.exe"
        ],
        "workdir": "aurora-opencode-pro",
        "timeout": 900000
      }
    },
    {
      "kind": "tests",
      "command": {
        "program": "C:\\Users\\windows10\\AppData\\Local\\Temp\\aurora-plan-strip-verify\\plan_strip_contracts.exe",
        "args": [],
        "workdir": "aurora-opencode-pro",
        "timeout": 300000
      }
    },
    {
      "kind": "prepare",
      "command": {
        "program": "C:\\Users\\windows10\\AppData\\Local\\Temp\\aurora-plan-strip-verify\\plan_strip_contracts.exe",
        "args": ["build/plan-strip-full.ppm"],
        "workdir": "aurora-opencode-pro",
        "timeout": 300000
      }
    },
    {
      "kind": "interaction",
      "command": {
        "program": "C:\\Users\\windows10\\AppData\\Local\\Temp\\aurora-plan-strip-verify\\plan_strip_contracts.exe",
        "args": ["build/plan-strip-interaction.ppm"],
        "workdir": "aurora-opencode-pro",
        "timeout": 300000
      }
    },
    {
      "kind": "prepare",
      "command": {
        "program": "python",
        "args": [
          "tests/crop_ppm.py", "build/plan-strip-full.ppm",
          "build/plan-strip-actual.ppm", "1030", "55", "470", "110"
        ],
        "workdir": "aurora-opencode-pro",
        "timeout": 120000
      }
    },
    {
      "kind": "render",
      "reference": "aurora-opencode-pro/tests/references/plan-strip-header.ppm",
      "actual": "aurora-opencode-pro/build/plan-strip-actual.ppm",
      "referenceSource": "Frozen crop (470x110 at 1030,55 of the 1500x1000 app paint-path frame) after visual inspection: title on the left ending in '· 1/2' and both plan rectangles right-aligned in the header"
    }
  ]
}
