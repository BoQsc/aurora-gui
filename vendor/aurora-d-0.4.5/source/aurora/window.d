module aurora.window;

import aurora.canvas : Canvas;
import aurora.color : Color;
import aurora.event : Event, EventType, Key, KeyModifier, MouseButton;
import aurora.font : FontFace, FontRenderMode, FontRole;
import aurora.platform.select : NativeWindow, NativeWindowSink, PlatformWindow, WindowOptions;
import aurora.render.base : RenderBackend, RendererPreference, RendererStats;
import aurora.render.drawlist : DrawList;
import aurora.render.scene : RenderLayer, RenderScene;
import aurora.render.select : createRenderBackend;
import aurora.render.software : SoftwareRenderer;
import aurora.surface : Surface;
import aurora.text.atlas : FontSystem;
import aurora.theme : Theme;
import aurora.types : CursorKind, DisplayScale, Point, PointF, Rect, Size, maxInt;
import aurora.widget : PopupSurface, Widget, WidgetHost;
import std.process : environment;

private enum ulong synchronizedPointerLayerId = ulong.max;


/**
 * The current Vulkan backend renders Aurora vector/atlas triangle batches but
 * does not yet upload retained RGB24 image commands. Video preview frames use
 * those RGB commands. Detect them before presentation so automatic or forced
 * Vulkan selection can never silently produce a black preview surface.
 */
private bool drawListContainsRgbImages(DrawList list)
    @safe pure nothrow @nogc
{
    return list !is null && list.rgbImages.length > 0;
}

private bool sceneContainsRgbImages(RenderScene scene)
    @safe pure nothrow @nogc
{
    if (scene is null) return false;
    if (drawListContainsRgbImages(scene.base)) return true;
    foreach (layer; scene.layers)
        if (layer.visible && drawListContainsRgbImages(layer.drawList))
            return true;
    return false;
}

/** Counters used to verify that transform-only interaction does no UI rebuild work. */
struct CompositorStats
{
    ulong frames;
    ulong baseBuilds;
    ulong layerBuilds;
    ulong layerOrderBuilds;
    ulong transformOnlyFrames;
    ulong lateLatchSamples;
    ulong lateLatchUpdates;
}

private final class LayerCache
{
    Widget widget;
    DrawList drawList;
    ulong id;
    ulong revision;
    bool dirty = true;
    Size logicalSize;
    Size framebufferSize;

    this(Widget value, DrawList list, ulong valueId)
    {
        widget = value;
        drawList = list;
        id = valueId;
    }
}

/** Owns a native window, renderer backend, font system, and widget tree. */
final class GuiWindow : WidgetHost, NativeWindowSink
{
    private WindowOptions _options;
    private Theme _theme;
    private Size _clientSize;
    private Size _framebufferSize;
    private DisplayScale _displayScale;
    private Surface _snapshot;
    private NativeWindow _native;
    private FontSystem _fonts;
    private DrawList _baseDrawList;
    private DrawList _pointerDrawList;
    private RenderScene _scene;
    private ulong _pointerRevision;
    private Size _pointerFramebufferSize;
    private PointF _pointerPosition;
    private PointF _lastPointerPosition;
    private bool _hasLastPointerPosition;
    private bool _pointerLayerBuilt;
    private bool _synchronizedPointerActive;
    private LayerCache[Widget] _layerCaches;
    private LayerCache[] _orderedLayers;
    private Widget[] _layerScratch;
    private ulong _nextLayerId = 1;
    private ulong _baseRevision;
    private bool _baseDirty = true;
    // Layout and paint performed while rebuilding the retained scene already
    // capture the resulting widget geometry. Suppress the redundant frame
    // invalidations generated by setBounds() during that same pass.
    private bool _buildingBase;
    private bool _sceneStructureDirty = true;
    private bool _frameDirty = true;
    private CompositorStats _compositorStats;
    private RenderBackend _renderer;
    private string _rendererFallbackReason;
    private Widget _root;
    private Widget _focused;
    private Widget _hovered;
    private Widget _captured;
    private bool _nativeFocused = true;
    private Widget _lastClickTarget;
    private MouseButton _lastClickButton;
    private long _lastClickTime;
    private Point _lastClickPosition;
    private int _clickCount;

    bool delegate() onCloseRequested;

    this(WindowOptions options, Theme theme = Theme.light())
    {
        _options = options;
        const rendererOverride = environment.get("AURORA_RENDERER", "");
        if (rendererOverride == "software") _options.renderer = RendererPreference.software;
        else if (rendererOverride == "vulkan") _options.renderer = RendererPreference.vulkan;
        const fontRenderOverride = environment.get("AURORA_FONT_RENDER_MODE", "");
        if (fontRenderOverride == "smooth") _options.fontRenderMode = FontRenderMode.smooth;
        else if (fontRenderOverride == "sharp") _options.fontRenderMode = FontRenderMode.sharp;
        applyBooleanOverride("AURORA_VSYNC", _options.vsync);
        applyBooleanOverride("AURORA_LOW_LATENCY", _options.lowLatency);
        applyBooleanOverride("AURORA_SYNC_DRAG_POINTER",
            _options.synchronizedDragPointer);
        applyBooleanOverride("AURORA_FULLSCREEN", _options.startFullscreen);
        _theme = theme;
        _clientSize = Size(maxInt(1, _options.width), maxInt(1, _options.height));
        _framebufferSize = _clientSize;
        _displayScale = DisplayScale.init;
        _fonts = new FontSystem(_options.uiFontPath, _options.monospaceFontPath,
            _options.fontRenderMode);
        applyThemeFonts();
        _baseDrawList = new DrawList(_fonts);
        _pointerDrawList = new DrawList(_fonts);
        _scene = new RenderScene();
        _snapshot = new Surface(_framebufferSize.width, _framebufferSize.height);
        _native = new PlatformWindow(_options, this);
        synchronizeNativeMetrics();
        _snapshot.resize(_framebufferSize.width, _framebufferSize.height);
        _renderer = createRenderBackend(_options, _native, _framebufferSize,
            _rendererFallbackReason);
    }

    Surface surface()
    {
        ensureScene();
        SoftwareRenderer.renderSceneInto(_scene, _snapshot);
        return _snapshot;
    }

    NativeWindow nativeWindow() @safe pure nothrow @nogc { return _native; }
    Widget root() @safe pure nothrow @nogc { return _root; }
    Widget focusedWidget() @safe pure nothrow @nogc { return _focused; }
    override FontSystem fontSystem() @safe pure nothrow @nogc { return _fonts; }
    Size logicalClientSize() const @safe pure nothrow @nogc { return _clientSize; }
    Size framebufferSize() const @safe pure nothrow @nogc { return _framebufferSize; }
    DisplayScale displayScale() const @safe pure nothrow @nogc { return _displayScale; }
    string rendererName() const { return _renderer is null ? "None" : _renderer.name(); }
    bool hardwareAccelerated() const { return _renderer !is null && _renderer.hardwareAccelerated(); }
    string rendererFallbackReason() const { return _rendererFallbackReason; }
    RendererStats rendererStats() const
    {
        return _renderer is null ? RendererStats.init : _renderer.stats();
    }

    void resetRendererStats()
    {
        if (_renderer !is null) _renderer.resetStats();
    }

    CompositorStats compositorStats() const @safe pure nothrow @nogc
    {
        return _compositorStats;
    }

    void resetCompositorStats() @safe nothrow @nogc
    {
        _compositorStats = CompositorStats.init;
    }

    void setRoot(Widget widget)
    {
        if (_root !is null)
        {
            detachSubtree(_root);
            _root.attachHost(null);
        }
        _root = widget;
        _layerCaches = null;
        _orderedLayers.length = 0;
        _layerScratch.length = 0;
        _sceneStructureDirty = true;
        _nextLayerId = 1;
        if (_root !is null)
        {
            _root.attachHost(this);
            _root.setBounds(Rect(0, 0, _clientSize.width, _clientSize.height));
            _root.layoutTree();
        }
        invalidate();
    }

    void setTheme(Theme value)
    {
        _theme = value;
        applyThemeFonts();
        invalidate();
    }

    void setFonts(FontFace ui, FontFace monospace = null)
    {
        _fonts.setFaces(ui, monospace);
        _theme.uiFont = _fonts.uiFace;
        _theme.monospaceFont = _fonts.monospaceFace;
        invalidate();
    }

    void setFontRenderMode(FontRenderMode mode)
    {
        _options.fontRenderMode = mode;
        _fonts.setRenderMode(mode);
        invalidate();
    }

    /** Add an ordered fallback face for complete grapheme clusters. */
    bool addFontFallback(FontRole role, FontFace face)
    {
        const added = _fonts.addFallback(role, face);
        if (added) invalidate();
        return added;
    }

    /** Load and add an ordered fallback face from an sfnt/TTC file. */
    bool addFontFallback(FontRole role, string path, uint faceIndex = 0)
    {
        const added = _fonts.addFallback(role, path, faceIndex);
        if (added) invalidate();
        return added;
    }

    void setTitle(string title)
    {
        _native.setTitle(title);
    }

    /** Enter or leave native monitor fullscreen without changing widget coordinates. */
    void setFullscreen(bool value)
    {
        if (_native is null || _native.fullscreen() == value) return;
        _options.startFullscreen = value;
        _native.setFullscreen(value);
        invalidate();
    }

    bool fullscreen() const
    {
        return _native !is null && _native.fullscreen();
    }

    void toggleFullscreen()
    {
        setFullscreen(!fullscreen());
    }

    int run()
    {
        if (_root !is null)
        {
            _root.setBounds(Rect(0, 0, _clientSize.width, _clientSize.height));
            _root.layoutTree();
        }
        _native.show();
        invalidate();
        return _native.run();
    }

    void close()
    {
        _native.close();
    }

    void saveScreenshot(string path)
    {
        surface().savePpm(path);
    }

    override const(Theme) currentTheme() const
    {
        return _theme;
    }

    override void invalidate()
    {
        // Widget layout calls setBounds() throughout the tree. During the
        // current base rebuild those changes are painted immediately below, so
        // requesting another full frame would only repeat the same work. Layer
        // caches are still marked dirty and will be rebuilt later in this pass.
        if (_buildingBase)
        {
            foreach (cache; _layerCaches)
                cache.dirty = true;
            return;
        }

        _baseDirty = true;
        foreach (cache; _layerCaches)
            cache.dirty = true;
        requestFrame();
    }

    override void invalidateWidget(Widget widget)
    {
        if (widget is null)
        {
            invalidate();
            return;
        }
        auto layer = widget.compositorRoot();

        // Bounds changes raised by layout are already represented by the base
        // draw list being recorded and by the retained layers built afterward.
        // Do not leave a second full-window frame queued behind this one.
        if (_buildingBase)
        {
            if (layer !is null)
                layerCache(layer).dirty = true;
            return;
        }

        if (layer is null)
            _baseDirty = true;
        else
            layerCache(layer).dirty = true;
        requestFrame();
    }

    override void invalidateTransform(Widget widget)
    {
        // A transform-only invalidation is valid only for a retained layer.
        // Fall back to normal content invalidation for ordinary widgets.
        if (widget is null || widget.compositorRoot() is null)
        {
            invalidateWidget(widget);
            return;
        }
        if (_buildingBase) return;
        requestFrame();
    }

    override void invalidateComposition()
    {
        _sceneStructureDirty = true;
        if (_buildingBase) return;
        requestFrame();
    }

    private void requestFrame()
    {
        _frameDirty = true;
        if (_native !is null)
            _native.invalidate();
    }

    override void requestFocus(Widget widget)
    {
        if (widget is _focused) return;
        if (_focused !is null)
            _focused.setFocusedInternal(false);
        _focused = widget;
        if (_focused !is null && _nativeFocused)
            _focused.setFocusedInternal(true);
    }

    override void captureMouse(Widget widget)
    {
        _captured = widget;
        beginSynchronizedPointer();
        if (continuousPointerFrames()) requestFrame();
    }

    override void releaseMouse(Widget widget)
    {
        if (_captured is widget)
        {
            endSynchronizedPointer();
            _captured = null;
            requestFrame();
        }
    }

    private void beginSynchronizedPointer()
    {
        if (!_options.lowLatency || !_options.synchronizedDragPointer ||
            _captured is null || !_captured.wantsContinuousPointerFrames() ||
            _native is null || !_native.setPointerVisible(false))
            return;
        _synchronizedPointerActive = true;
        if (!_native.queryPointerPosition(_pointerPosition))
            _pointerPosition = _hasLastPointerPosition ? _lastPointerPosition :
                _captured.preciseGlobalOrigin();
        _lastPointerPosition = _pointerPosition;
        _hasLastPointerPosition = true;
        requestFrame();
    }

    private void endSynchronizedPointer()
    {
        if (!_synchronizedPointerActive) return;
        _synchronizedPointerActive = false;
        if (_native !is null) _native.setPointerVisible(true);
        requestFrame();
    }

    private bool continuousPointerFrames() const @safe pure nothrow @nogc
    {
        return _options.lowLatency && _captured !is null &&
            _captured.wantsContinuousPointerFrames();
    }

    override void updateCursor(CursorKind cursor)
    {
        _native.setCursor(cursor);
    }

    override void bringToFront(Widget widget)
    {
        if (_root is null || widget is null) return;
        auto layer = widget.compositorRoot();
        if (layer !is null && layer.parent() !is null)
        {
            layer.parent().bringChildToFront(layer);
            return;
        }
        auto top = widget;
        while (top.parent() !is null && top.parent() !is _root)
            top = top.parent();
        if (top.parent() is _root)
            _root.bringChildToFront(top);
    }

    override void closeHostWindow()
    {
        close();
    }

    override void detachSubtree(Widget subtree)
    {
        if (subtree is null) return;
        if (subtree.containsWidget(_focused))
            requestFocus(null);
        if (subtree.containsWidget(_captured))
        {
            endSynchronizedPointer();
            _captured = null;
        }
        if (subtree.containsWidget(_hovered))
        {
            if (_hovered !is null) _hovered.setHoveredInternal(false);
            _hovered = null;
            if (_native !is null) _native.setCursor(CursorKind.arrow);
        }
        if (subtree.containsWidget(_lastClickTarget))
        {
            _lastClickTarget = null;
            _clickCount = 0;
        }
    }

    override bool onNativePaint()
    {
        ensureScene();

        // RGB24 video frames are currently a software-renderer capability.
        // Switch before drawing the first such frame instead of letting Vulkan
        // ignore the image batch and present an apparently valid black frame.
        if (_renderer !is null && _renderer.hardwareAccelerated() &&
            sceneContainsRgbImages(_scene))
        {
            _renderer.shutdown();
            _rendererFallbackReason =
                "Vulkan RGB video surfaces are not implemented in Aurora-D 0.4.5; " ~
                "switched to the software compositor for correct preview output.";
            _renderer = new SoftwareRenderer(_framebufferSize);
        }

        bool completed;
        try
            completed = _renderer.renderScene(_scene);
        catch (Exception error)
        {
            if (_options.renderer != RendererPreference.automatic ||
                _renderer is null || !_renderer.hardwareAccelerated())
                throw error;
            _renderer.shutdown();
            _rendererFallbackReason = error.msg;
            _renderer = new SoftwareRenderer(_framebufferSize);
            completed = _renderer.renderScene(_scene);
        }
        if (!completed) return false;
        auto software = _renderer.softwareSurface();
        if (software !is null)
            _native.present(software.pixels(), software.width(), software.height());
        // During transform drags, keep a render opportunity pending even when
        // Windows has not delivered another WM_MOUSEMOVE yet. The renderer
        // latches GetCursorPos after image acquisition, like a game loop, so
        // every available presentation slot uses the newest pointer position.
        return !continuousPointerFrames();
    }

    override void onNativeTick(double deltaSeconds)
    {
        if (_root !is null)
            _root.tickTree(deltaSeconds);
    }

    override bool onNativeCloseRequested()
    {
        return onCloseRequested is null ? true : onCloseRequested();
    }

    override void onNativeShutdown()
    {
        endSynchronizedPointer();
        if (_renderer !is null)
            _renderer.shutdown();
    }

    override void onNativeEvent(ref Event event)
    {
        if (event.type == EventType.mouseMove || event.type == EventType.mouseDown ||
            event.type == EventType.mouseUp || event.type == EventType.mouseWheel)
        {
            _lastPointerPosition = event.hasPrecisePosition ?
                event.preciseGlobalPosition : PointF(event.globalPosition);
            _hasLastPointerPosition = true;
        }
        switch (event.type)
        {
            case EventType.resized:
                handleResize(event);
                break;
            case EventType.mouseMove:
                handleMouseMove(event);
                break;
            case EventType.mouseDown:
                handleMouseDown(event);
                break;
            case EventType.mouseUp:
                handleMouseUp(event);
                break;
            case EventType.mouseWheel:
                handleMouseWheel(event);
                break;
            case EventType.keyDown:
                handleKey(event, true);
                break;
            case EventType.keyUp:
                handleKey(event, false);
                break;
            case EventType.textInput:
                handleText(event);
                break;
            case EventType.filesDropped:
                handleFilesDropped(event);
                break;
            case EventType.focusGained:
                _nativeFocused = true;
                if (_root !is null) _root.notifyHostFocusChanged(true);
                if (_focused !is null) _focused.setFocusedInternal(true);
                break;
            case EventType.focusLost:
                _nativeFocused = false;
                if (_focused !is null) _focused.setFocusedInternal(false);
                if (_root !is null) _root.notifyHostFocusChanged(false);
                endSynchronizedPointer();
                _captured = null;
                break;
            default:
                break;
        }
    }

    private void handleResize(ref Event event)
    {
        DisplayScale scale = event.displayScale;
        Size framebuffer = event.framebufferSize;
        if (_native !is null)
        {
            scale = _native.displayScale();
            framebuffer = _native.framebufferSize();
        }
        if (scale.dpiX == 0 || scale.dpiY == 0)
            scale = DisplayScale.init;
        const width = maxInt(1, event.size.width);
        const height = maxInt(1, event.size.height);
        _clientSize = Size(width, height);
        _displayScale = scale;
        if (framebuffer.empty()) framebuffer = scale.logicalToPhysical(_clientSize);
        _framebufferSize = Size(maxInt(1, framebuffer.width), maxInt(1, framebuffer.height));
        _snapshot.resize(_framebufferSize.width, _framebufferSize.height);
        if (_renderer !is null) _renderer.resize(_framebufferSize);
        if (_root !is null)
        {
            _root.setBounds(Rect(0, 0, width, height));
            _root.layoutTree();
        }
        invalidate();
    }

    private LayerCache layerCache(Widget widget)
    {
        auto existing = widget in _layerCaches;
        if (existing !is null)
            return *existing;
        auto created = new LayerCache(widget, new DrawList(_fonts), _nextLayerId++);
        _layerCaches[widget] = created;
        return created;
    }

    private void rebuildLayerOrder()
    {
        _layerScratch.length = 0;
        if (_root !is null)
            _root.collectComposited(_layerScratch);
        _orderedLayers.length = 0;
        foreach (layer; _layerScratch)
            _orderedLayers ~= layerCache(layer);

        // Detached widgets release their CPU-side retained geometry. Hidden
        // layers keep their cache and can reappear without repainting content.
        Widget[] stale;
        foreach (widget, cache; _layerCaches)
            if (widget is null || widget.host() !is this)
                stale ~= widget;
        foreach (widget; stale)
            _layerCaches.remove(widget);

        _sceneStructureDirty = false;
        ++_compositorStats.layerOrderBuilds;
    }

    private void ensureScene()
    {
        if (!_frameDirty && _scene.base !is null) return;

        bool rebuiltContent;
        if (_baseDirty)
        {
            _baseDirty = false;
            _baseDrawList.reset(_clientSize, _framebufferSize, _displayScale,
                _theme.windowBackground);
            if (_root !is null)
            {
                _buildingBase = true;
                scope (exit) _buildingBase = false;
                _root.layoutTree();
                auto canvas = Canvas(_baseDrawList, _clientSize.width, _clientSize.height);
                _root.paintTreeSkippingComposited(canvas);
            }
            ++_baseRevision;
            ++_compositorStats.baseBuilds;
            rebuiltContent = true;
        }

        if (_sceneStructureDirty)
            rebuildLayerOrder();

        _scene.reset(_baseDrawList, _baseRevision, _framebufferSize);
        foreach (cache; _orderedLayers)
        {
            auto layer = cache.widget;
            if (layer is null) continue;
            const logicalSize = Size(maxInt(1, layer.bounds().width),
                maxInt(1, layer.bounds().height));
            const physicalSize = _displayScale.logicalToPhysical(logicalSize);
            if (cache.logicalSize != logicalSize || cache.framebufferSize != physicalSize)
                cache.dirty = true;

            if (layer.visible() && cache.dirty)
            {
                cache.dirty = false;
                cache.logicalSize = logicalSize;
                cache.framebufferSize = physicalSize;
                cache.drawList.reset(logicalSize, physicalSize, _displayScale,
                    Color.rgba(0, 0, 0, 0));
                layer.layoutTree();
                auto canvas = Canvas(cache.drawList, logicalSize.width, logicalSize.height)
                    .translated(-layer.bounds().x, -layer.bounds().y);
                layer.paintTree(canvas);
                ++cache.revision;
                ++_compositorStats.layerBuilds;
                rebuiltContent = true;
            }

            const origin = layer.preciseGlobalOrigin();
            RenderLayer rendered;
            rendered.id = cache.id;
            rendered.revision = cache.revision;
            rendered.drawList = cache.drawList;
            const deviceOrigin = _displayScale.logicalToPhysical(origin);
            rendered.deviceBounds = Rect(deviceOrigin.x, deviceOrigin.y,
                physicalSize.width, physicalSize.height);
            rendered.visible = layer.visible();
            rendered.opaque = layer.compositedOpaque();
            _scene.addLayer(rendered);
        }

        if (_synchronizedPointerActive || _pointerLayerBuilt)
        {
            ensurePointerDrawList();
            RenderLayer pointerLayer;
            pointerLayer.id = synchronizedPointerLayerId;
            pointerLayer.revision = _pointerRevision;
            pointerLayer.drawList = _pointerDrawList;
            const pointerDevice = _displayScale.logicalToPhysical(_pointerPosition);
            pointerLayer.deviceBounds = Rect(pointerDevice.x, pointerDevice.y,
                _pointerFramebufferSize.width, _pointerFramebufferSize.height);
            pointerLayer.visible = _synchronizedPointerActive;
            _scene.addLayer(pointerLayer);
        }

        _scene.setLateLatch(&lateLatchScene);
        ++_compositorStats.frames;
        if (!rebuiltContent)
            ++_compositorStats.transformOnlyFrames;
        _frameDirty = false;
    }

    /**
     * Re-sample the captured pointer after a swapchain image is available and
     * update only retained layer transforms. No widget layout or paint occurs.
     */
    private void lateLatchScene()
    {
        if (_captured is null || _native is null) return;
        PointF latest;
        if (!_native.queryPointerPosition(latest)) return;
        _lastPointerPosition = latest;
        _hasLastPointerPosition = true;
        ++_compositorStats.lateLatchSamples;
        bool changed = _captured.onPointerLatch(latest);
        if (_synchronizedPointerActive && _pointerPosition != latest)
        {
            _pointerPosition = latest;
            changed = true;
        }
        if (!changed) return;
        ++_compositorStats.lateLatchUpdates;
        refreshSceneTransforms();
    }

    private void refreshSceneTransforms()
    {
        foreach (cache; _orderedLayers)
        {
            auto layer = cache.widget;
            if (layer is null) continue;
            foreach (ref rendered; _scene.layers)
            {
                if (rendered.id != cache.id) continue;
                const device = _displayScale.logicalToPhysical(
                    layer.preciseGlobalOrigin());
                rendered.deviceBounds.x = device.x;
                rendered.deviceBounds.y = device.y;
                break;
            }
        }
        if (_pointerLayerBuilt)
        {
            const device = _displayScale.logicalToPhysical(_pointerPosition);
            foreach (ref rendered; _scene.layers)
            {
                if (rendered.id != synchronizedPointerLayerId) continue;
                rendered.deviceBounds.x = device.x;
                rendered.deviceBounds.y = device.y;
                rendered.visible = _synchronizedPointerActive;
                break;
            }
        }
    }

    private void ensurePointerDrawList()
    {
        enum pointerWidth = 20;
        enum pointerHeight = 28;
        const logicalSize = Size(pointerWidth, pointerHeight);
        const physicalSize = _displayScale.logicalToPhysical(logicalSize);
        if (_pointerLayerBuilt && _pointerFramebufferSize == physicalSize) return;
        _pointerFramebufferSize = physicalSize;
        _pointerDrawList.reset(logicalSize, physicalSize, _displayScale,
            Color.rgba(0, 0, 0, 0));
        const clip = Rect(0, 0, pointerWidth, pointerHeight);
        auto canvas = Canvas(_pointerDrawList, pointerWidth, pointerHeight);

        // A compact vector cursor with a zero/zero hotspot. Drawing it as an
        // Aurora layer keeps the visible cursor and dragged window in the same
        // submitted frame, removing the apparent trail behind a hardware cursor.
        canvas.drawLine(Point(7, 14), Point(13, 27), Color.rgba(0, 0, 0, 230), 5);
        canvas.drawLine(Point(7, 14), Point(13, 27), Color.rgb(255, 255, 255), 2);
        _pointerDrawList.addSolidTriangle(Point(0, 0), Point(1, 22), Point(18, 16),
            Color.rgba(0, 0, 0, 235), clip);
        _pointerDrawList.addSolidTriangle(Point(2, 3), Point(3, 17), Point(14, 14),
            Color.rgb(255, 255, 255), clip);
        _pointerLayerBuilt = true;
        ++_pointerRevision;
        if (_pointerRevision == 0) ++_pointerRevision;
    }

    private static void applyBooleanOverride(string name, ref bool value)
    {
        const setting = environment.get(name, "");
        switch (setting)
        {
            case "1": case "true": case "TRUE": case "on": case "ON":
            case "yes": case "YES":
                value = true;
                break;
            case "0": case "false": case "FALSE": case "off": case "OFF":
            case "no": case "NO":
                value = false;
                break;
            default:
                break;
        }
    }

    private void applyThemeFonts()
    {
        if (_theme.uiFont is null) _theme.uiFont = _fonts.uiFace;
        if (_theme.monospaceFont is null) _theme.monospaceFont = _fonts.monospaceFace;
    }

    private void synchronizeNativeMetrics()
    {
        if (_native is null) return;
        _clientSize = _native.clientSize();
        _framebufferSize = _native.framebufferSize();
        _displayScale = _native.displayScale();
        if (_clientSize.empty())
            _clientSize = Size(maxInt(1, _options.width), maxInt(1, _options.height));
        if (_framebufferSize.empty())
            _framebufferSize = _displayScale.logicalToPhysical(_clientSize);
    }

    private Widget targetAt(Point point)
    {
        return _root is null ? null : _root.hitTest(point);
    }

    private void updateHover(Point point)
    {
        auto next = targetAt(point);
        if (next is _hovered) return;
        if (_hovered !is null) _hovered.setHoveredInternal(false);
        _hovered = next;
        if (_hovered !is null)
        {
            _hovered.setHoveredInternal(true);
            _native.setCursor(_hovered.cursor());
        }
        else
        {
            _native.setCursor(CursorKind.arrow);
        }
    }

    private Widget nearestFocusable(Widget widget)
    {
        auto current = widget;
        while (current !is null)
        {
            if (current.focusable()) return current;
            current = current.parent();
        }
        return null;
    }

    private void updateClickCount(Widget target, ref Event event)
    {
        const dx = event.globalPosition.x - _lastClickPosition.x;
        const dy = event.globalPosition.y - _lastClickPosition.y;
        const closeEnough = dx * dx + dy * dy <= 36;
        const timeDelta = event.timestampMs - _lastClickTime;
        if (target is _lastClickTarget && event.button == _lastClickButton &&
            closeEnough && timeDelta >= 0 && timeDelta <= 500)
            _clickCount = _clickCount >= 3 ? 1 : _clickCount + 1;
        else
            _clickCount = 1;
        _lastClickTarget = target;
        _lastClickButton = event.button;
        _lastClickTime = event.timestampMs;
        _lastClickPosition = event.globalPosition;
        event.clickCount = _clickCount;
    }

    private bool dispatchToBubble(Widget target, ref Event event)
    {
        auto current = target;
        while (current !is null)
        {
            event.position = current.globalToLocal(event.globalPosition);
            bool handled;
            switch (event.type)
            {
                case EventType.mouseMove: handled = current.onMouseMove(event); break;
                case EventType.mouseDown: handled = current.onMouseDown(event); break;
                case EventType.mouseUp: handled = current.onMouseUp(event); break;
                case EventType.mouseWheel: handled = current.onMouseWheel(event); break;
                case EventType.filesDropped: handled = current.onFilesDropped(event); break;
                case EventType.keyDown: handled = current.onKeyDown(event); break;
                case EventType.keyUp: handled = current.onKeyUp(event); break;
                case EventType.textInput: handled = current.onTextInput(event); break;
                default: break;
            }
            if (handled) return true;
            current = current.parent();
        }
        return false;
    }

    private void handleMouseMove(ref Event event)
    {
        // Mouse capture fixes the target for a drag. Re-running a full-tree hit
        // test and changing hover state behind that target only creates extra
        // invalidations and can make pointer-driven motion feel one frame late.
        if (_captured is null)
            updateHover(event.globalPosition);
        auto target = _captured !is null ? _captured : _hovered;
        if (target !is null)
            dispatchToBubble(target, event);
    }

    private void handleMouseDown(ref Event event)
    {
        if (dismissOutsidePopups(event)) return;
        updateHover(event.globalPosition);
        auto target = _captured !is null ? _captured : _hovered;
        updateClickCount(target, event);
        if (target !is null)
        {
            auto focusTarget = nearestFocusable(target);
            if (focusTarget !is null) requestFocus(focusTarget);
            dispatchToBubble(target, event);
        }
        else
        {
            requestFocus(null);
        }
    }

    private void handleMouseUp(ref Event event)
    {
        if (_captured is null)
            updateHover(event.globalPosition);
        auto target = _captured !is null ? _captured : _hovered;
        if (target !is null)
            dispatchToBubble(target, event);
        // A captured widget commonly releases capture from onMouseUp. Refresh
        // hover once, after dispatch, at the final pointer position.
        if (_captured is null)
            updateHover(event.globalPosition);
    }

    private void handleMouseWheel(ref Event event)
    {
        updateHover(event.globalPosition);
        if (_hovered !is null)
            dispatchToBubble(_hovered, event);
    }

    private void handleFilesDropped(ref Event event)
    {
        updateHover(event.globalPosition);
        auto target = targetAt(event.globalPosition);
        if (target !is null)
            dispatchToBubble(target, event);
    }

    private void cycleFocus(bool reverse)
    {
        if (_root is null) return;
        Widget[] focusable;
        _root.collectFocusable(focusable);
        if (focusable.length == 0) return;
        int current = -1;
        foreach (index, widget; focusable)
            if (widget is _focused) current = cast(int) index;
        int next;
        if (reverse)
            next = current <= 0 ? cast(int) focusable.length - 1 : current - 1;
        else
            next = current < 0 || current + 1 >= cast(int) focusable.length ? 0 : current + 1;
        requestFocus(focusable[cast(size_t) next]);
    }

    private void handleKey(ref Event event, bool down)
    {
        // Transient UI gets the first Escape.  This keeps Escape from leaving
        // fullscreen while a start/context menu is still open and mirrors
        // established desktop behavior.
        if (down && event.key == Key.escape && !event.control() && !event.alt() &&
            !event.meta())
        {
            auto popup = _root is null ? null : _root.topmostPopupSurface();
            if (popup !is null)
            {
                popup.dismissPopup();
                updateHover(event.globalPosition);
                return;
            }
        }
        if (_options.enableFullscreenShortcut)
        {
            const toggleKey = event.key == Key.f11 ||
                (event.key == Key.enter && event.alt() && !event.control() && !event.meta());
            if (toggleKey)
            {
                if (down && !event.repeat) toggleFullscreen();
                return;
            }
            if (event.key == Key.escape && fullscreen() && !event.control() &&
                !event.alt() && !event.meta())
            {
                if (down) setFullscreen(false);
                return;
            }
        }
        if (down && event.key == Key.tab && !event.control() && !event.alt() && !event.meta())
        {
            cycleFocus(event.shift());
            return;
        }
        auto target = _focused !is null ? _focused : _root;
        if (target !is null)
            dispatchToBubble(target, event);
    }

    private void handleText(ref Event event)
    {
        auto target = _focused !is null ? _focused : _root;
        if (target !is null)
            dispatchToBubble(target, event);
    }

    /**
     * Close every topmost popup that does not contain this press.  Dismissed
     * popups are removed/hidden before the normal hit test, allowing the same
     * click to activate an underlying window or taskbar button.  A popup can
     * consume the event for its own anchor (the Start button is the canonical
     * example) so a close click does not immediately reopen it.
     */
    private bool dismissOutsidePopups(ref Event event)
    {
        if (_root is null) return false;
        foreach (_; 0 .. 32)
        {
            auto popup = _root.topmostPopupSurface();
            if (popup is null || popup.popupContains(event.globalPosition))
                return false;

            auto popupWidget = cast(Widget) popup;
            const consumed = popup.dismissPopupForPointer(event.globalPosition,
                event.button);
            if (consumed)
            {
                updateHover(event.globalPosition);
                return true;
            }

            // A malformed popup must not make input dispatch spin forever.
            auto next = _root.topmostPopupSurface();
            if (next is popup || (popupWidget !is null && popupWidget.visible() &&
                    popupWidget.parent() !is null))
                return false;
        }
        return false;
    }
}
