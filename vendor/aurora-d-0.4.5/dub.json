        "user32",
        "gdi32"
      ],
      "lflags-osx": [
        "-framework",
        "AppKit",
        "-framework",
        "CoreGraphics",
        "-framework",
        "CoreFoundation",
        "-framework",
        "QuartzCore",
        "-lobjc"
