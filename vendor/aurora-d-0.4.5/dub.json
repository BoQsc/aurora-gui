{
  "name": "aurora-d",
  "description": "Cross-platform Vulkan/software GUI library for D with an Aurora-rendered retained compositor and pure-D Unicode/OpenType text",
  "authors": [
    "OpenAI"
  ],
  "copyright": "Copyright \u00a9 2026 OpenAI",
  "license": "BSL-1.0",
  "sourcePaths": [
    "source"
  ],
  "targetName": "aurora",
  "buildTypes": {
    "portable-release": {
      "buildOptions": [
        "releaseMode",
        "optimize",
        "inline"
      ],
      "dflags-windows-dmd": [
        "-mscrtlib=libcmt"
      ],
      "dflags-windows-ldc": [
        "-mscrtlib=libcmt"
      ]
    }
  },
