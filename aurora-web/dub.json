{
  "name": "aurora-web",
  "description": "A cross-platform standards-oriented web engine library built on Aurora-D: HTML/CSS parsing, DOM, layout, painting, and a JavaScript host",
  "authors": [
    "aurora-gui contributors"
  ],
  "copyright": "Copyright (C) 2026 aurora-gui contributors",
  "license": "0BSD",
  "targetType": "library",
  "sourcePaths": [
    "source",
    "../vendor/aurora-d-0.4.5/source"
  ],
  "libs-windows": [
    "user32",
    "gdi32",
    "shell32",
    "ws2_32",
    "advapi32"
  ],
  "libs-linux": [
    "X11",
    "dl"
  ],
  "lflags-osx": [
    "-framework",
    "AppKit",
    "-framework",
    "CoreGraphics",
    "-framework",
    "CoreFoundation",
    "-framework",
    "QuartzCore",
    "-lobjc"
  ],
  "buildTypes": {
    "portable-release": {
      "buildOptions": [
        "releaseMode",
        "optimize",
        "inline"
      ],
      "dflags-windows-dmd": [
        "-mscrtlib=libcmt"
      ],
      "dflags-windows-ldc": [
        "-mscrtlib=libcmt"
      ]
    }
  },
  "version": "0.66.3"
}
