{
  "name": "aurora-browser",
  "description": "A desktop web browser shell on Aurora-D rendering pages with the aurora-web engine",
  "authors": [
    "OpenAI"
  ],
  "copyright": "Copyright \u00a9 2026 OpenAI",
  "license": "BSL-1.0",
  "targetType": "executable",
  "targetName": "aurora-browser",
  "mainSourceFile": "source/app.d",
  "sourcePaths": [
    "source",
    "../vendor/aurora-d-0.4.5/source",
    "../aurora-web/source"
  ],
  "libs-windows": [
    "user32",
    "gdi32",
    "shell32",
    "ws2_32",
    "advapi32"
  ],
  "buildTypes": {
    "debug": {
      "_comment": "Keep symbols/asserts but optimize: an unoptimized build ran the engine ~1.4-1.5x slower (shaping, layout, paint).",
      "buildOptions": [
        "debugMode",
        "debugInfo",
        "optimize"
      ]
    },
    "portable-release": {
      "buildOptions": [
        "releaseMode",
        "optimize",
        "inline"
      ],
      "dflags-windows-dmd": [
        "-mscrtlib=libcmt"
      ],
      "dflags-windows-ldc": [
        "-mscrtlib=libcmt"
      ]
    }
  },
  "lflags-windows": [
    "/SUBSYSTEM:WINDOWS",
    "/ENTRY:mainCRTStartup"
  ],
  "libs-linux": [
    "X11",
    "dl"
  ],
  "lflags-osx": [
    "-framework",
    "AppKit",
    "-framework",
    "CoreGraphics",
    "-framework",
    "CoreFoundation",
    "-framework",
    "QuartzCore",
    "-lobjc"
  ],
  "version": "0.66.3"
}
