{
  "inputs": [
    "aurora-web/source",
    "aurora-browser/source",
    "vendor/aurora-d-0.4.5/source",
    "aurora-browser/tests/pageperf-probe.d",
    "aurora-browser/tests/check-page-memory.py"
  ],
  "steps": [
    {
      "kind": "compile",
      "command": {
        "program": "dmd",
        "args": [
          "-m64",
          "-version=AuroraHeadless",
          "-i",
          "-Iaurora-web/source",
          "-Iaurora-browser/source",
          "-Ivendor/aurora-d-0.4.5/source",
          "-of=C:/Users/windows10/AppData/Local/Temp/aurora-evtest/pageperf-mem.exe",
          "-od=C:/Users/windows10/AppData/Local/Temp/aurora-evtest/pageperfmem",
          "aurora-browser/tests/pageperf-probe.d",
          "-Luser32.lib",
          "-Lgdi32.lib",
          "-Lshell32.lib",
          "-Lws2_32.lib",
          "-Ladvapi32.lib",
          "-Lole32.lib"
        ],
        "workdir": ".",
        "timeout": 300000
      }
    },
    {
      "kind": "tests",
      "command": {
        "program": "python",
        "args": [
          "-u",
          "-B",
          "aurora-browser/tests/check-page-memory.py",
          "C:/Users/windows10/AppData/Local/Temp/aurora-evtest/pageperf-mem.exe",
          "https://boqsc.eu/",
          "1280",
          "900"
        ],
        "workdir": ".",
        "timeout": 300000
      }
    }
  ]
}
