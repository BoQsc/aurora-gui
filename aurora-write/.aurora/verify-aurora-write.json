{
  "inputs": [
    "aurora-write/source",
    "aurora-write/tests",
    "aurora-write/dub.json",
    "aurora-write/tools",
    "aurora-write/RUN-WINDOWS.bat",
    "aurora-write/VERIFY-WINDOWS.bat",
    "vendor/aurora-d-0.4.5/source/aurora/widgets/texteditor.d"
  ],
  "steps": [
    {
      "kind": "compile",
      "command": {
        "program": "dmd",
        "args": [
          "-unittest",
          "-main",
          "-Isource",
          "-of=build/unit-tests.exe",
          "source/aurorawrite/concision.d",
          "source/aurorawrite/llmclient.d",
          "wininet.lib"
        ],
        "workdir": "aurora-write",
        "timeout": 300000
      }
    },
    {
      "kind": "tests",
      "command": {
        "program": "build/unit-tests.exe",
        "args": [],
        "workdir": "aurora-write",
        "timeout": 120000
      }
    },
    {
      "kind": "compile",
      "command": {
        "program": "dub",
        "args": [
          "build",
          "--config=smoke",
          "--build=debug"
        ],
        "workdir": "aurora-write",
        "timeout": 600000
      }
    },
    {
      "kind": "tests",
      "command": {
        "program": "aurora-write-smoke.exe",
        "args": [],
        "workdir": "aurora-write",
        "timeout": 240000
      }
    },
    {
      "kind": "compile",
      "command": {
        "program": "dub",
        "args": [
          "build",
          "--config=default",
          "--build=release"
        ],
        "workdir": "aurora-write",
        "timeout": 900000
      }
    },
    {
      "kind": "interaction",
      "command": {
        "program": "aurora-write.exe",
        "args": [
          "--screenshot",
          "artifacts/aurora-write-suggestions.ppm"
        ],
        "workdir": "aurora-write",
        "timeout": 180000
      }
    },
    {
      "kind": "prepare",
      "command": {
        "program": "python",
        "args": [
          "-u",
          "-B",
          "tools/ppm-to-png.py",
          "artifacts/aurora-write-suggestions.ppm",
          "artifacts/aurora-write-suggestions.png"
        ],
        "workdir": "aurora-write",
        "timeout": 120000
      }
    }
  ]
}
