{
  "name": "aurora-d",
  "description": "Cross-platform Vulkan/software GUI library for D with an Aurora-rendered retained compositor and pure-D Unicode/OpenType text",
  "authors": [
    "aurora-gui contributors"
  ],
  "copyright": "Copyright (C) 2026 aurora-gui contributors",
  "license": "0BSD",
  "sourcePaths": [
    "source"
  ],
  "targetName": "aurora",
  "libs-windows": [
    "user32",
    "gdi32"
  ],
  "libs-linux": [
    "X11",
    "dl"
  ],
  "buildTypes": {
    "portable-release": {
      "buildOptions": [
        "releaseMode",
        "optimize",
        "inline"
      ],
      "dflags-windows-dmd": [
        "-mscrtlib=libcmt"
      ],
      "dflags-windows-ldc": [
        "-mscrtlib=libcmt"
      ]
    }
  },
  "configurations": [
    {
      "name": "library",
      "targetType": "library",
      "targetName": "aurora",
      "libs-linux": [
        "X11",
        "dl"
      ],
      "libs-windows": [
        "user32",
        "gdi32"
      ],
      "lflags-osx": [
        "-framework",
        "AppKit",
        "-framework",
        "CoreGraphics",
        "-framework",
        "CoreFoundation",
        "-framework",
        "QuartzCore",
        "-lobjc"
      ]
    },
    {
      "name": "headless-test",
      "targetType": "executable",
      "targetName": "aurora-headless-test",
      "mainSourceFile": "tests/headless.d",
      "versions": [
        "AuroraHeadless"
      ],
      "libs-linux": [
        "dl"
      ]
    },
    {
      "name": "unicode-conformance",
      "targetType": "executable",
      "targetName": "aurora-unicode-conformance",
      "mainSourceFile": "tests/unicode_conformance.d",
      "versions": [
        "AuroraHeadless"
      ]
    },
    {
      "name": "text-system-test",
      "targetType": "executable",
      "targetName": "aurora-text-system-test",
      "mainSourceFile": "tests/text_system.d",
      "versions": [
        "AuroraHeadless"
      ]
    },
    {
      "name": "hinting-regression-probe",
      "targetType": "executable",
