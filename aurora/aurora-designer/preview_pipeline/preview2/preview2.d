import aurora;

import aurora;

// Generated by Aurora Designer.
// Artboard 900 x 560.

Widget buildDesignedUi()
{
    auto window = new Panel();
    window.setId("window1");
    window.setBounds(Rect(0, 0, 900, 560));

        auto Preview_panel = new Panel();
        Preview_panel.setId("panel2");
        Preview_panel.setBounds(Rect(40, 40, 220, 140));
        window.add(Preview_panel);
            auto Preview_action = new Button();
            Preview_action.setId("preview-action");
            Preview_action.setText("Generated preview v2");
            Preview_action.setBounds(Rect(64, 96, 96, 38));
            Preview_panel.add(Preview_action);
    return window;
}

void main()
{
    auto root = buildDesignedUi();
    WindowOptions options;
    options.title = "Aurora generated preview";
    options.width = 900;
    options.height = 560;
    options.decorated = false;
    options.renderer = RendererPreference.software;
    auto window = new GuiWindow(options, Theme.dark());
    window.setRoot(root);
    auto driver = new UiTestDriver(window);
    driver.resize(Size(900, 560));
    driver.paint();
    window.saveScreenshot("preview.ppm");
    window.close();
}
