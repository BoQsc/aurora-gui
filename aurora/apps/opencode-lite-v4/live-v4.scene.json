{
  "schemaVersion": 2,
  "window": {
    "title": "Aurora OpenCode Lite V4",
    "width": 1100,
    "height": 650,
    "minWidth": 1000,
    "minHeight": 620,
    "theme": "dark"
  },
  "root": {
    "type": "column",
    "padding": 0,
    "spacing": 0,
    "children": [
      {
        "type": "row",
        "height": 54,
        "padding": 16,
        "spacing": 10,
        "children": [
          {
            "type": "label",
            "text": "Aurora OpenCode Lite V4",
            "scale": 2,
            "flex": 1
          },
          {
            "id": "lite-live-mode",
            "type": "label",
            "text": "LIVE V4",
            "scale": 1,
            "textColor": "#69d2a8"
          },
          {
            "id": "lite-live-version",
            "type": "label",
            "text": "v4",
            "scale": 1,
            "textColor": "#7d8ea3"
          },
          {
            "id": "lite-status",
            "type": "label",
            "text": "Ready",
            "width": 210,
            "textColor": "#9fb3c8"
          }
        ]
      },
      {
        "type": "row",
        "flex": 1,
        "padding": 16,
        "spacing": 12,
        "children": [
          {
            "type": "column",
            "width": 220,
            "padding": 12,
            "spacing": 8,
            "children": [
              {
                "type": "label",
                "text": "SESSION RAIL",
                "scale": 1,
                "textColor": "#69d2a8"
              },
              {
                "id": "lite-session",
                "type": "label",
                "text": "Session - 0 messages",
                "textColor": "#d5dee8"
              },
              {
                "type": "separator",
                "orientation": "horizontal"
              },
              {
                "id": "lite-clear",
                "type": "button",
                "text": "New session",
                "action": "clear"
              },
              {
                "id": "lite-retry",
                "type": "button",
                "text": "Retry",
                "action": "retry"
              },
              {
                "type": "spacer",
                "flex": 1
              },
              {
                "type": "label",
                "text": "LIVE DEVELOPMENT",
                "scale": 1,
                "textColor": "#566476"
              },
              {
                "type": "label",
                "text": "one window",
                "scale": 1,
                "textColor": "#566476"
              }
            ]
          },
          {
            "type": "column",
            "width": 300,
            "padding": 12,
            "spacing": 8,
            "children": [
              {
                "type": "label",
                "text": "INSPECTOR",
                "scale": 1,
                "textColor": "#69d2a8"
              },
              {
                "type": "label",
                "text": "PROVIDER",
                "scale": 1,
                "textColor": "#7d8ea3"
              },
              {
                "type": "row",
                "spacing": 6,
                "children": [
                  {
                    "id": "lite-provider-opencode",
                    "type": "button",
                    "text": "OpenCode",
                    "action": "preset-opencode"
                  },
                  {
                    "id": "lite-provider-openai",
                    "type": "button",
                    "text": "OpenAI",
                    "action": "preset-openai"
                  }
                ]
              },
              {
                "type": "label",
                "text": "Base URL",
                "scale": 1,
                "textColor": "#a9b7c7"
              },
              {
                "id": "lite-base",
                "type": "textField",
                "text": "https://opencode.ai/zen/go/v1"
              },
              {
                "type": "label",
                "text": "Model",
                "scale": 1,
                "textColor": "#a9b7c7"
              },
              {
                "id": "lite-model",
                "type": "textField",
                "text": "deepseek-v4.1-flash"
              },
              {
                "id": "lite-key-state",
                "type": "label",
                "text": "No key",
                "textColor": "#9fb3c8"
              },
              {
                "id": "lite-key",
                "type": "textField"
              },
              {
                "id": "lite-save",
                "type": "button",
                "text": "Save connection",
                "action": "save"
              },
              {
                "type": "spacer",
                "flex": 1
              },
              {
                "type": "label",
                "text": "v4 live shell",
                "scale": 1,
                "textColor": "#566476"
              }
            ]
          },
          {
            "type": "column",
            "padding": 12,
            "spacing": 8,
            "flex": 1,
            "children": [
              {
                "type": "label",
                "text": "CONVERSATION",
                "scale": 1,
                "textColor": "#69d2a8"
              },
              {
                "type": "row",
                "height": 44,
                "spacing": 8,
                "children": [
                  {
                    "id": "lite-send",
                    "type": "button",
                    "text": "Send",
                    "action": "send",
                    "width": 96
                  },
                  {
                    "id": "lite-input",
                    "type": "textField",
                    "flex": 1,
                    "submitAction": "send"
                  }
                ]
              },
              {
                "id": "lite-transcript",
                "type": "textArea",
                "text": "New session.\n",
                "readOnly": true,
                "height": 420
              },
              {
                "type": "row",
                "height": 44,
                "spacing": 8,
                "children": []
              }
            ]
          }
        ]
      }
    ]
  }
}