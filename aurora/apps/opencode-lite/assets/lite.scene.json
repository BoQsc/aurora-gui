{
  "schemaVersion": 2,
  "window": {
    "title": "Aurora OpenCode Lite",
    "width": 960,
    "height": 680,
    "theme": "dark"
  },
  "root": {
    "type": "column",
    "padding": 14,
    "spacing": 8,
    "children": [
      {
        "type": "label",
        "text": "Aurora OpenCode Lite",
        "scale": 2
      },
      {
        "type": "row",
        "spacing": 6,
        "children": [
          {
            "type": "label",
            "text": "Base URL",
            "width": 72
          },
          {
            "id": "lite-base",
            "type": "textField",
            "text": "https://api.openai.com/v1",
            "flex": 1
          }
        ]
      },
      {
        "type": "row",
        "spacing": 6,
        "children": [
          {
            "type": "label",
            "text": "Model",
            "width": 64
          },
          {
            "id": "lite-model",
            "type": "textField",
            "text": "gpt-4o-mini",
            "flex": 1
          }
        ]
      },
      {
        "type": "row",
        "spacing": 6,
        "children": [
          {
            "type": "label",
            "text": "API key",
            "width": 72
          },
          {
            "id": "lite-key",
            "type": "textField",
            "text": "",
            "flex": 1
          }
        ]
      },
      {
        "type": "row",
        "spacing": 6,
        "children": [
          {
            "id": "lite-save",
            "type": "button",
            "text": "Save",
            "action": "save"
          },
          {
            "id": "lite-status",
            "type": "label",
            "text": "Ready",
            "flex": 1
          }
        ]
      },
      {
        "type": "row",
        "spacing": 6,
        "children": [
          {
            "id": "lite-send",
            "type": "button",
            "text": "Send",
            "action": "send"
          },
          {
            "id": "lite-input",
            "type": "textField",
            "flex": 1
          }
        ]
      },
      {
        "id": "lite-transcript",
        "type": "textArea",
        "text": "No conversation yet.\n",
        "readOnly": true,
        "height": 240
      }
    ]
  }
}
