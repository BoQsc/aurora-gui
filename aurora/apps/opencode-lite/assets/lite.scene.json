{
  "schemaVersion": 2,
  "window": {
    "title": "Aurora OpenCode Lite",
    "width": 960,
    "height": 680,
    "minWidth": 960,
    "minHeight": 680,
    "theme": "dark"
  },
  "root": {
    "type": "column",
    "padding": 16,
    "spacing": 8,
    "children": [
      {
        "type": "row",
        "height": 36,
        "spacing": 10,
        "children": [
          {
            "type": "label",
            "text": "Aurora OpenCode Lite",
            "scale": 2,
            "flex": 1
          },

          {
            "id": "lite-status",
            "type": "label",
            "text": "Ready",
            "width": 260,
            "textColor": "#9fb3c8"
          }
        ]
      },
      {
        "type": "label",
        "text": "CONNECTION",
        "scale": 1,
        "textColor": "#7d8ea3"
      },
      {
        "type": "row",
        "spacing": 8,
        "children": [
          {
            "type": "label",
            "text": "Provider",
            "width": 72,
            "textColor": "#a9b7c7"
          },
          {
            "id": "lite-provider-opencode",
            "type": "button",
            "text": "OpenCode",
            "action": "preset-opencode"
          },
          {
            "id": "lite-provider-openai",
            "type": "button",
            "text": "OpenAI",
            "action": "preset-openai"
          }
        ]
      },
      {
        "type": "row",
        "spacing": 8,
        "children": [
          {
            "type": "label",
            "text": "Base URL",
            "width": 72,
            "textColor": "#a9b7c7"
          },
          {
            "id": "lite-base",
            "type": "textField",
            "text": "https://opencode.ai/zen/go/v1",
            "flex": 1
          }
        ]
      },
      {
        "type": "row",
        "spacing": 8,
        "children": [
          {
            "type": "label",
            "text": "Model",
            "width": 64,
            "textColor": "#a9b7c7"
          },
          {
            "id": "lite-model",
            "type": "textField",
            "text": "gpt-4o-mini",
            "flex": 1
          }
        ]
      },
      {
        "type": "row",
        "spacing": 8,
        "children": [
          {
            "type": "label",
            "text": "API key",
            "width": 72,
            "textColor": "#a9b7c7"
          },
          {
            "id": "lite-key",
            "type": "textField",
            "text": "",
            "flex": 1
          },
          {
            "id": "lite-key-state",
            "type": "label",
            "text": "No key",
            "width": 64,
            "textColor": "#9fb3c8"
          }
        ]
      },
      {
        "type": "row",
        "spacing": 8,
        "children": [
          {
            "type": "spacer",
            "flex": 1
          },
          {
            "type": "label",
            "text": "Stored locally",
            "scale": 1,
            "textColor": "#7d8ea3"
          },
          {
            "id": "lite-save",
            "type": "button",
            "text": "Save",
            "action": "save"
          }
        ]
      },
      {
        "type": "label",
        "text": "MESSAGE",
        "scale": 1,
        "textColor": "#7d8ea3"
      },
      {
        "type": "row",
        "spacing": 8,
        "height": 40,
        "children": [
          {
            "id": "lite-input",
            "type": "textField",
            "width": 650,
            "submitAction": "send"
          },
          {
            "id": "lite-send",
            "type": "button",
            "text": "Send",
            "action": "send"
          }
        ]
      },
      {
        "type": "label",
        "text": "CONVERSATION",
        "scale": 1,
        "textColor": "#7d8ea3"
      },
      {
        "id": "lite-transcript",
        "type": "textArea",
        "text": "No conversation yet.\n",
        "readOnly": true,
        "flex": 1
      }
    ]
  }
}
