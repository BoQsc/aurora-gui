{
  "schemaVersion": 2,
  "window": {
    "title": "Aurora OpenCode Lite V50",
    "width": 1911,
    "height": 991,
    "minWidth": 1280,
    "minHeight": 800,
    "theme": "dark"
  },
  "root": {
    "type": "column",
    "padding": 0,
    "spacing": 0,
    "children": [
      {
        "type": "row",
        "height": 80,
        "padding": 14,
        "spacing": 10,
        "background": "#0d151c",
        "border": "#263542",
        "children": [
          {
            "id": "brand-widget",
            "type": "component",
            "component": "opencode.universal",
            "width": 500,
            "height": 64,
            "props": {
              "kicker": "",
              "title": "AURORA // OPENCODE",
              "subtitle": "V50 COMMAND CENTER",
              "accent": "#69d2a8",
              "background": "#111b24",
              "border": "#2b3a48",
              "radius": 8,
              "shadow": true,
              "accentBar": true,
              "padding": 6
            }
          },
          {
            "type": "spacer",
            "flex": 1
          },
          {
            "id": "lite-live-mode",
            "type": "label",
            "text": "LIVE",
            "width": 60,
            "align": "right",
            "textColor": "#69d2a8"
          },
          {
            "id": "lite-live-version",
            "type": "label",
            "text": "v50",
            "width": 50,
            "align": "right",
            "textColor": "#7d8ea3"
          }
        ]
      },
      {
        "type": "row",
        "height": 42,
        "padding": 6,
        "spacing": 4,
        "background": "#0b1117",
        "border": "#263542",
        "children": [
          {
            "id": "menu-session",
            "type": "menu",
            "text": "Session",
            "items": [
              {
                "label": "New session",
                "shortcut": "Ctrl+N",
                "action": "clear"
              },
              {
                "label": "Export session",
                "shortcut": "Ctrl+E",
                "action": "export"
              },
              {
                "label": "Import session",
                "action": "import"
              },
              {
                "separator": true
              },
              {
                "label": "Workspaces",
                "children": [
                  {
                    "label": "Main",
                    "action": "session-1"
                  },
                  {
                    "label": "Research",
                    "action": "session-2"
                  },
                  {
                    "label": "Scratch",
                    "action": "session-3"
                  }
                ]
              },
              {
                "separator": true
              },
              {
                "label": "Keyboard shortcuts",
                "action": "help"
              },
              {
                "label": "Retry last prompt",
                "action": "retry"
              },
              {
                "label": "Regenerate response",
                "action": "regenerate"
              }
            ],
            "height": 26,
            "fontSize": 12
          },
          {
            "id": "menu-model",
            "type": "menu",
            "text": "Model",
            "items": [
              {
                "label": "OpenCode profile",
                "action": "preset-opencode"
              },
              {
                "label": "OpenAI profile",
                "action": "preset-openai"
              },
              {
                "separator": true
              },
              {
                "label": "DeepSeek model",
                "action": "model-deepseek"
              },
              {
                "label": "GPT-4o mini model",
                "action": "model-gpt"
              },
              {
                "separator": true
              },
              {
                "label": "Save connection",
                "action": "save"
              },
              {
                "label": "Save key",
                "action": "save-key"
              }
            ],
            "height": 26,
            "fontSize": 12
          },
          {
            "id": "menu-help",
            "type": "menu",
            "text": "Help",
            "items": [
              {
                "label": "Keyboard shortcuts",
                "shortcut": "F1",
                "action": "help"
              },
              {
                "label": "Dismiss banner",
                "action": "dismiss-banner"
              },
              {
                "label": "Clear key",
                "action": "clear-key"
              }
            ],
            "height": 26,
            "fontSize": 12
          },
          {
            "type": "spacer",
            "flex": 1
          }
        ]
      },
      {
        "type": "row",
        "flex": 1,
        "padding": 16,
        "spacing": 16,
        "children": [
          {
            "type": "column",
            "width": 280,
            "padding": 10,
            "spacing": 5,
            "background": "#151f29",
            "border": "#2b3a48",
            "radius": 8,
            "children": [
              {
                "id": "sessions-widget",
                "type": "component",
                "component": "opencode.universal",
                "width": 260,
                "height": 64,
                "props": {
                  "kicker": "WORKSPACE",
                  "title": "SESSIONS",
                  "subtitle": "Local sessions and search",
                  "accent": "#69d2a8",
                  "background": "#111b24",
                  "border": "#2b3a48",
                  "radius": 8,
                  "shadow": false,
                  "accentBar": false,
                  "padding": 6
                }
              },
              {
                "id": "lite-slot-1",
                "type": "button",
                "text": "Main",
                "action": "session-1",
                "height": 28,
                "style": "toolbar",
                "active": true
              },
              {
                "id": "lite-slot-2",
                "type": "button",
                "text": "Research",
                "action": "session-2",
                "height": 28,
                "style": "toolbar",
                "active": false
              },
              {
                "id": "lite-slot-3",
                "type": "button",
                "text": "Scratch",
                "action": "session-3",
                "height": 28,
                "style": "toolbar",
                "active": false
              },
              {
                "id": "lite-session",
                "type": "label",
                "text": "Workspace 1 - 0 messages",
                "textColor": "#d5dee8"
              },
              {
                "id": "lite-usage",
                "type": "label",
                "text": "Messages 0 | idle",
                "scale": 1,
                "textColor": "#9fb3c8"
              },
              {
                "id": "last-prompt",
                "type": "label",
                "text": "Last sent: none",
                "scale": 1,
                "textColor": "#7d8ea3"
              },
              {
                "type": "row",
                "height": 28,
                "spacing": 5,
                "children": [
                  {
                    "id": "lite-search",
                    "type": "textField",
                    "flex": 1,
                    "fontSize": 12
                  },
                  {
                    "id": "workspace-search",
                    "type": "button",
                    "text": "Find",
                    "action": "workspace-search",
                    "width": 70,
                    "height": 28
                  }
                ]
              },
              {
                "id": "search-result",
                "type": "label",
                "text": "Enter a search term",
                "scale": 1,
                "textColor": "#7d8ea3"
              },
              {
                "type": "spacer",
                "flex": 1
              },
              {
                "type": "row",
                "height": 20,
                "spacing": 6,
                "children": [
                  {
                    "type": "label",
                    "text": "STATUS",
                    "scale": 1,
                    "textColor": "#566476"
                  },
                  {
                    "id": "lite-status",
                    "type": "label",
                    "text": "Ready",
                    "scale": 1,
                    "textColor": "#9fb3c8",
                    "flex": 1
                  }
                ]
              }
            ]
          },
          {
            "type": "column",
            "padding": 10,
            "spacing": 6,
            "background": "#10161d",
            "border": "#263542",
            "radius": 8,
            "children": [
              {
                "type": "row",
                "height": 22,
                "spacing": 8,
                "children": [
                  {
                    "type": "label",
                    "text": "CONVERSATION",
                    "textColor": "#69d2a8"
                  },
                  {
                    "type": "label",
                    "text": "MESSAGE ROLES \u00b7 TIMESTAMPS",
                    "scale": 1,
                    "textColor": "#7d8ea3"
                  },
                  {
                    "id": "transcript-meta",
                    "type": "label",
                    "text": "",
                    "width": 1,
                    "height": 1,
                    "scale": 1,
                    "textColor": "#10161d"
                  }
                ]
              },
              {
                "id": "lite-transcript",
                "type": "textArea",
                "flex": 1,
                "readOnly": true,
                "lineNumbers": false,
                "highlightCurrentLine": false,
                "menu": [
                  {
                    "label": "Export session",
                    "action": "export"
                  },
                  {
                    "label": "Search transcript",
                    "action": "workspace-search"
                  },
                  {
                    "label": "Clear session",
                    "action": "clear"
                  },
                  {
                    "label": "Keyboard shortcuts",
                    "action": "help"
                  }
                ]
              },
              {
                "type": "row",
                "height": 22,
                "spacing": 12,
                "children": [
                  {
                    "id": "composer-state",
                    "type": "label",
                    "text": "Composer empty",
                    "flex": 1,
                    "scale": 1,
                    "textColor": "#9fb3c8"
                  },
                  {
                    "id": "composer-count",
                    "type": "label",
                    "text": "0 characters",
                    "width": 120,
                    "align": "right",
                    "scale": 1,
                    "textColor": "#7d8ea3"
                  }
                ]
              },
              {
                "type": "row",
                "height": 34,
                "spacing": 6,
                "children": [
                  {
                    "id": "lite-input",
                    "type": "textField",
                    "flex": 1,
                    "submitAction": "send",
                    "menu": [
                      {
                        "label": "Send",
                        "action": "send"
                      },
                      {
                        "label": "Clear composer",
                        "action": "composer-clear"
                      },
                      {
                        "label": "Keyboard shortcuts",
                        "action": "help"
                      }
                    ]
                  },
                  {
                    "id": "lite-send",
                    "type": "button",
                    "text": "Send",
                    "action": "send",
                    "width": 90,
                    "height": 30,
                    "background": "#2ea36d",
                    "textColor": "#ffffff"
                  },
                  {
                    "id": "composer-clear",
                    "type": "button",
                    "text": "Clear",
                    "action": "composer-clear",
                    "width": 80,
                    "height": 30
                  }
                ]
              }
            ],
            "flex": 1
          },
          {
            "type": "column",
            "width": 320,
            "padding": 10,
            "spacing": 4,
            "background": "#151f29",
            "border": "#2b3a48",
            "radius": 8,
            "children": [
              {
                "id": "inspector-widget",
                "type": "component",
                "component": "opencode.universal",
                "width": 300,
                "height": 64,
                "props": {
                  "kicker": "CONNECTION",
                  "title": "INSPECTOR",
                  "subtitle": "Provider and key state",
                  "accent": "#69d2a8",
                  "background": "#111b24",
                  "border": "#2b3a48",
                  "radius": 8,
                  "shadow": false,
                  "accentBar": false,
                  "padding": 6
                }
              },
              {
                "type": "label",
                "text": "Base URL",
                "scale": 1,
                "textColor": "#a9b7c7"
              },
              {
                "id": "lite-base",
                "type": "textField",
                "width": 310,
                "fontSize": 12
              },
              {
                "type": "label",
                "text": "Model",
                "scale": 1,
                "textColor": "#a9b7c7"
              },
              {
                "id": "lite-model",
                "type": "textField",
                "width": 310,
                "fontSize": 12
              },
              {
                "type": "row",
                "height": 22,
                "spacing": 8,
                "children": [
                  {
                    "id": "lite-key-state",
                    "type": "label",
                    "text": "Key set",
                    "flex": 1,
                    "scale": 1,
                    "textColor": "#9fb3c8"
                  },
                  {
                    "id": "lite-provider-health",
                    "type": "label",
                    "text": "Provider ready",
                    "width": 150,
                    "scale": 1,
                    "textColor": "#69d2a8"
                  }
                ]
              },
              {
                "type": "label",
                "text": "API key",
                "scale": 1,
                "textColor": "#a9b7c7"
              },
              {
                "id": "lite-key",
                "type": "textField",
                "width": 310,
                "fontSize": 12
              },
              {
                "type": "label",
                "text": "Enter a new key to replace it",
                "scale": 1,
                "textColor": "#7d8ea3"
              },
              {
                "type": "row",
                "height": 30,
                "spacing": 6,
                "children": [
                  {
                    "id": "lite-save-key",
                    "type": "button",
                    "text": "Save key",
                    "action": "save-key",
                    "width": 100,
                    "height": 28
                  },
                  {
                    "id": "lite-save",
                    "type": "button",
                    "text": "Save connection",
                    "action": "save",
                    "width": 210,
                    "height": 28
                  }
                ]
              },
              {
                "id": "key-clear-toast",
                "type": "label",
                "text": "",
                "scale": 1,
                "textColor": "#10161d",
                "width": 1,
                "height": 1,
                "fontSize": 8
              },
              {
                "type": "spacer",
                "flex": 1
              }
            ]
          }
        ]
      },
      {
        "type": "row",
        "height": 48,
        "padding": 10,
        "spacing": 10,
        "background": "#0b1117",
        "children": [
          {
            "type": "label",
            "text": "AURORA HOST",
            "scale": 1,
            "textColor": "#69d2a8"
          },
          {
            "type": "label",
            "text": "\u00b7",
            "scale": 1,
            "textColor": "#566476"
          },
          {
            "type": "label",
            "text": "control 127.0.0.1:8792",
            "scale": 1,
            "textColor": "#566476"
          },
          {
            "type": "spacer",
            "flex": 1
          },
          {
            "id": "command-palette-recent",
            "type": "label",
            "text": "Recent: none",
            "width": 1,
            "scale": 1,
            "textColor": "#10161d",
            "height": 1,
            "fontSize": 8
          },
          {
            "id": "command-palette-selected",
            "type": "label",
            "text": "Focus: Help",
            "width": 1,
            "scale": 1,
            "textColor": "#10161d",
            "height": 1,
            "fontSize": 8
          },
          {
            "id": "text-audit",
            "type": "label",
            "text": "TEXT FIT PENDING",
            "width": 260,
            "scale": 1,
            "textColor": "#69d2a8"
          }
        ]
      }
    ]
  }
}