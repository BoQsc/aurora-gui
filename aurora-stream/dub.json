{
  "name": "aurora-stream",
  "description": "A focused multi-output Twitch and YouTube broadcaster built with Aurora-D and FFmpeg",
  "authors": [
    "OpenAI"
  ],
  "copyright": "Copyright © 2026 OpenAI",
  "license": "BSL-1.0",
  "sourcePaths": [
    "source",
    "../vendor/aurora-d-0.4.5/source"
  ],
  "stringImportPaths": [
    "embedded",
    "assets"
  ],
  "buildTypes": {
    "portable-release": {
      "buildOptions": [
        "releaseMode",
        "optimize",
        "inline"
      ],
      "dflags-windows-dmd": [
        "-mscrtlib=libcmt"
      ],
      "dflags-windows-ldc": [
        "-mscrtlib=libcmt"
      ]
    },
    "portable-single-exe": {
      "buildOptions": [
        "releaseMode",
        "optimize",
        "inline"
      ],
      "versions": [
        "BundledFfmpeg"
      ],
      "dflags-windows-dmd": [
        "-mscrtlib=libcmt"
      ],
      "dflags-windows-ldc": [
        "-mscrtlib=libcmt"
      ]
    }
  },
  "preBuildCommands-windows": [
    "python ..\\scripts\\version.py sync --program aurora-stream"
  ],
  "configurations": [
    {
      "name": "application",
      "targetType": "executable",
      "targetName": "aurora-stream",
      "mainSourceFile": "source/app_titlebar.d",
      "libs-linux": [
        "X11",
        "dl"
      ],
      "libs-windows": [
        "user32",
        "gdi32",
        "shell32",
        "ole32",
        "avrt",
        "kernel32",
        "wininet"
      ],
      "lflags-windows": [
        "/SUBSYSTEM:WINDOWS",
        "/ENTRY:mainCRTStartup"
      ],
      "lflags-osx": [
        "-framework",
        "AppKit",
        "-framework",
        "CoreGraphics",
        "-framework",
        "CoreFoundation",
        "-framework",
        "QuartzCore",
        "-lobjc"
      ]
    },
    {
      "name": "notitlebar",
      "targetType": "executable",
      "targetName": "aurora-stream-notitlebar",
      "mainSourceFile": "source/app.d",
      "libs-linux": [
        "X11",
        "dl"
      ],
      "libs-windows": [
        "user32",
        "gdi32",
        "shell32",
        "ole32",
        "avrt",
        "kernel32",
        "wininet"
      ],
      "lflags-windows": [
        "/SUBSYSTEM:WINDOWS",
        "/ENTRY:mainCRTStartup"
      ],
      "lflags-osx": [
        "-framework",
        "AppKit",
        "-framework",
        "CoreGraphics",
        "-framework",
        "CoreFoundation",
        "-framework",
        "QuartzCore",
        "-lobjc"
      ]
    }
  ],
  "version": "0.61.0"
}
