{
  "name": "aurora-cut",
  "description": "A lightweight MP4/MP3 timeline editor built with Aurora-D and FFmpeg",
  "authors": [
    "OpenAI"
  ],
  "copyright": "Copyright © 2026 OpenAI",
  "license": "BSL-1.0",
  "targetType": "executable",
  "targetName": "aurora-cut",
  "mainSourceFile": "source/app.d",
  "sourcePaths": [
    "source",
    "vendor/aurora-d-0.4.5/source"
  ],
  "stringImportPaths": [
    "embedded",
    "assets"
  ],
  "libs-linux": [
    "X11",
    "dl"
  ],
  "libs-windows": [
    "user32",
    "gdi32",
    "shell32",
    "winmm",
    "wininet"
  ],
  "lflags-windows": [
    "/SUBSYSTEM:WINDOWS",
    "/ENTRY:mainCRTStartup"
  ],
  "preBuildCommands-windows": [
    "python scripts\\version.py sync --program aurora-cut"
  ],
  "buildTypes": {
    "portable-release": {
      "buildOptions": [
        "releaseMode",
        "optimize",
        "inline"
      ],
      "dflags-windows-dmd": [
        "-mscrtlib=libcmt"
      ],
      "dflags-windows-ldc": [
        "-mscrtlib=libcmt"
      ]
    },
    "portable-single-exe": {
      "buildOptions": [
        "releaseMode",
        "optimize",
        "inline"
      ],
      "versions": [
        "BundledFfmpeg"
      ],
      "dflags-windows-dmd": [
        "-mscrtlib=libcmt"
      ],
      "dflags-windows-ldc": [
        "-mscrtlib=libcmt"
      ]
    }
  },
  "lflags-osx": [
    "-framework",
    "AppKit",
    "-framework",
    "CoreGraphics",
    "-framework",
    "CoreFoundation",
    "-framework",
    "QuartzCore",
    "-lobjc"
  ],
  "version": "0.66.3"
}
