{
  "inputs": [
    "verification/compile_probe.d",
    "verification/crop_ui_region.py",
    "verification/reference/software-ui.png",
    "verification/software_gui_probe.py",
    "verification/test_render_evidence.py",
    "aurora-opencode-pro/source/app.d",
    "vendor/aurora-d-0.4.5/source/aurora/window.d",
    "vendor/aurora-d-0.4.5/source/aurora/render/vulkan.d",
    "vendor/aurora-d-0.4.5/source/aurora/render/select.d"
  ],
  "steps": [
    {
      "kind": "compile",
      "command": {
        "program": "dmd",
        "args": ["-c", "-o-", "-Ivendor/aurora-d-0.4.5/source", "-i", "verification/compile_probe.d"],
        "workdir": ".",
        "timeout": 300000
      }
    },
    {
      "kind": "tests",
      "command": {
        "program": "python",
        "args": ["-u", "-B", "verification/test_render_evidence.py", "-v"],
        "workdir": ".",
        "timeout": 120000
      }
    },
    {
      "kind": "prepare",
      "command": {
        "program": "aurora-opencode-pro/aurora-opencode-pro.exe",
        "args": ["--screenshot", "C:/Users/windows10/AppData/Local/Temp/aurora-verify.ppm"],
        "workdir": ".",
        "timeout": 300000
      }
    },
    {
      "kind": "prepare",
      "command": {
        "program": "python",
        "args": ["-B", "verification/crop_ui_region.py",
                 "C:/Users/windows10/AppData/Local/Temp/aurora-verify.ppm",
                 "C:/Users/windows10/AppData/Local/Temp/aurora-verify-ui.png"],
        "workdir": ".",
        "timeout": 60000
      }
    },
    {
      "kind": "render",
      "reference": "verification/reference/software-ui.png",
      "actual": "C:/Users/windows10/AppData/Local/Temp/aurora-verify-ui.png",
      "referenceSource": "Header buttons from the known-good software-renderer screenshot; static region excludes clock and conversation content."
    },
    {
      "kind": "interaction",
      "command": {
        "program": "python",
        "args": ["-u", "-B", "verification/software_gui_probe.py",
                 "aurora-opencode-pro/aurora-opencode-pro.exe"],
        "workdir": ".",
        "timeout": 180000
      }
    }
  ]
}
