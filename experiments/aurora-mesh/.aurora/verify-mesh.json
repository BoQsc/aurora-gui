{
  "inputs": [
    "experiments/aurora-mesh/source",
    "experiments/aurora-mesh/dub.json",
    "experiments/aurora-mesh/assets"
  ],
  "steps": [
    {
      "kind": "compile",
      "command": {
        "program": "dub",
        "args": ["build", "--build=debug", "--dest=build/verify"],
        "workdir": "experiments/aurora-mesh",
        "timeout": 300000
      }
    },
    {
      "kind": "tests",
      "command": {
        "program": "dub",
        "args": ["test", "--build=debug"],
        "workdir": "experiments/aurora-mesh",
        "timeout": 300000
      }
    },
    {
      "kind": "tests",
      "command": {
        "program": "build/verify/aurora-mesh.exe",
        "args": ["--check"],
        "workdir": "experiments/aurora-mesh",
        "timeout": 60000
      }
    },
    {
      "kind": "prepare",
      "command": {
        "program": "build/verify/aurora-mesh.exe",
        "args": ["--export-glb", "build/verify-human.glb"],
        "workdir": "experiments/aurora-mesh",
        "timeout": 120000
      }
    },
    {
      "kind": "tests",
      "command": {
        "program": "build/verify/aurora-mesh.exe",
        "args": ["--glb", "build/verify-human.glb", "--check"],
        "workdir": "experiments/aurora-mesh",
        "timeout": 120000
      }
    },
    {
      "kind": "prepare",
      "command": {
        "program": "build/verify/aurora-mesh.exe",
        "args": ["--render", "build/verify-human.ppm", "--width", "800", "--height", "600"],
        "workdir": "experiments/aurora-mesh",
        "timeout": 120000
      }
    },
    {
      "kind": "prepare",
      "command": {
        "program": "python",
        "args": ["-c", "import json;from pathlib import Path;Path('build/verify-live.json').write_text(json.dumps({'revision':1,'commands':[{'type':'object','shape':'box','position':[0,1.6,0],'scale':0.5}]}))"],
        "workdir": "experiments/aurora-mesh",
        "timeout": 30000
      }
    },
    {
      "kind": "tests",
      "command": {
        "program": "build/verify/aurora-mesh.exe",
        "args": ["--glb", "build/verify-human.glb", "--live", "build/verify-live.json", "--screenshot", "build/verify-live.ppm", "--width", "800", "--height", "600"],
        "workdir": "experiments/aurora-mesh",
        "timeout": 120000
      }
    },
    {
      "kind": "tests",
      "command": {
        "program": "python",
        "args": ["-c", "import json;from pathlib import Path;a=json.loads(Path('build/live-ack.json').read_text());assert a.get('revision')==1 and a.get('objects')==1;a"],
        "workdir": "experiments/aurora-mesh",
        "timeout": 30000
      }
    },
    {
      "kind": "prepare",
      "command": {
        "program": "python",
        "args": ["-c", "import json;from pathlib import Path;Path('build/verify-workbench.json').write_text(json.dumps({'revision':1,'commands':[{'type':'new-animation','name':'VerifyAnim','duration':1.0,'additive':True,'tracks':[{'node':'Human','keys':[{'time':0,'rotation':[0,0,0,1]},{'time':1,'rotation':[0,0,0.1,0.995]}]}]},{'type':'keyframe','node':'Human','time':0.5,'rotation':[0,0,0,1]},{'type':'frame','frame':15},{'type':'audit'},{'type':'scan-frames'}]}))"],
        "workdir": "experiments/aurora-mesh",
        "timeout": 30000
      }
    },
    {
      "kind": "tests",
      "command": {
        "program": "build/verify/aurora-mesh.exe",
        "args": ["--glb", "build/verify-human.glb", "--live", "build/verify-workbench.json", "--screenshot", "build/verify-workbench.ppm", "--width", "800", "--height", "600"],
        "workdir": "experiments/aurora-mesh",
        "timeout": 120000
      }
    },
    {
      "kind": "tests",
      "command": {
        "program": "python",
        "args": ["-c", "import json;from pathlib import Path;a=json.loads(Path('build/live-ack.json').read_text());assert a.get('clip')=='VerifyAnim' and a.get('tracks')==1 and a.get('keys')==3 and a.get('frame')==15 and a.get('valid') is True and a.get('frameScan')==30 and a.get('invalidFrames')==0;a"],
        "workdir": "experiments/aurora-mesh",
        "timeout": 30000
      }
    }
  ]
}
