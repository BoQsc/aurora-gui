{
  "schemaVersion": 2,
  "window": {
    "title": "Aurora Host UI Depth",
    "width": 980,
    "height": 640,
    "theme": "light"
  },
  "themeOverrides": {
    "windowBackground": "#f3f3f3",
    "panelBackground": "#f7f7f7",
    "panelElevated": "#ffffff",
    "text": "#1f2328",
    "textMuted": "#5b6573",
    "border": "#c9ced6",
    "accent": "#2563eb",
    "selection": "#dbeafe",
    "fieldBackground": "#ffffff",
    "buttonBackground": "#eef1f5",
    "buttonHover": "#e2e8f0",
    "buttonPressed": "#d5dce6",
    "cornerRadius": 3,
    "borderWidth": 1,
    "controlHeight": 28,
    "fontScale": 1,
    "spacing": 4
  },
  "root": {
    "id": "workbench",
    "type": "column",
    "spacing": 0,
    "padding": 0,
    "background": "#f3f3f3",
    "children": [
      {
        "id": "menubar",
        "type": "row",
        "height": 30,
        "spacing": 0,
        "padding": 2,
        "background": "#f5f6f7",
        "border": "#d0d4da",
        "children": [
          {
            "id": "file-menu",
            "type": "menu",
            "text": "File",
            "items": [
              {"label": "New", "shortcut": "Ctrl+N", "icon": "new", "action": "file.new"},
              {"label": "Open...", "shortcut": "Ctrl+O", "icon": "open", "action": "file.open"},
              {"separator": true},
              {"label": "Save", "shortcut": "Ctrl+S", "icon": "save", "action": "file.save"},
              {"label": "Save As...", "shortcut": "Ctrl+Shift+S", "action": "file.saveAs"},
              {"separator": true},
              {"label": "Recent Files", "icon": "clock", "children": [
                {"label": "notes.txt", "action": "file.open.recent.notes"},
                {"label": "config.json", "action": "file.open.recent.config"}
              ]},
              {"separator": true},
              {"label": "Exit", "icon": "power", "action": "app.exit"}
            ]
          },
          {
            "id": "edit-menu",
            "type": "menu",
            "text": "Edit",
            "items": [
              {"label": "Undo", "shortcut": "Ctrl+Z", "action": "edit.undo"},
              {"label": "Redo", "shortcut": "Ctrl+Y", "action": "edit.redo"},
              {"separator": true},
              {"label": "Cut", "shortcut": "Ctrl+X", "action": "edit.cut"},
              {"label": "Copy", "shortcut": "Ctrl+C", "action": "edit.copy"},
              {"label": "Paste", "shortcut": "Ctrl+V", "action": "edit.paste"},
              {"separator": true},
              {"label": "Select All", "shortcut": "Ctrl+A", "action": "edit.selectAll"},
              {"separator": true},
              {"label": "Word wrap", "checked": true, "action": "view.wrap"},
              {"label": "Read only", "enabled": false, "action": "view.readOnly"}
            ]
          },
          {
            "id": "view-menu",
            "type": "menu",
            "text": "View",
            "items": [
              {"label": "Show toolbar", "checked": true, "action": "view.toolbar"},
              {"label": "Show status bar", "checked": true, "action": "view.status"},
              {"separator": true},
              {"label": "Zoom", "icon": "search", "children": [
                {"label": "Zoom in", "shortcut": "Ctrl++", "action": "view.zoomIn"},
                {"label": "Zoom out", "shortcut": "Ctrl+-", "action": "view.zoomOut"},
                {"label": "Restore default zoom", "action": "view.zoomReset"}
              ]},
              {"separator": true},
              {"label": "Full screen", "shortcut": "F11", "action": "view.fullScreen"}
            ]
          },
          {
            "id": "search-menu",
            "type": "menu",
            "text": "Search",
            "items": [
              {"label": "Find...", "shortcut": "Ctrl+F", "icon": "search", "action": "search.find"},
              {"label": "Replace...", "shortcut": "Ctrl+H", "action": "search.replace"},
              {"label": "Find in Files...", "shortcut": "Ctrl+Shift+F", "action": "search.files"},
              {"separator": true},
              {"label": "Go to line...", "shortcut": "Ctrl+G", "action": "search.goto"}
            ]
          },
          {
            "id": "help-menu",
            "type": "menu",
            "text": "Help",
            "items": [
              {"label": "About Aurora Host", "icon": "computer", "action": "help.about"},
              {"label": "Keyboard shortcuts", "action": "help.shortcuts"}
            ]
          }
        ]
      },
      {
        "id": "toolbar",
        "type": "row",
        "height": 42,
        "spacing": 2,
        "padding": 4,
        "background": "#f7f8fa",
        "border": "#d7dbe1",
        "children": [
          {"id": "tb-new", "type": "button", "text": "New", "style": "toolbar", "icon": "new", "action": "file.new"},
          {"id": "tb-open", "type": "button", "text": "Open", "style": "toolbar", "icon": "open", "action": "file.open"},
          {"id": "tb-save", "type": "button", "text": "Save", "style": "toolbar", "icon": "save", "action": "file.save", "tooltip": "Save the current document (Ctrl+S)"},
          {"id": "tb-sep-1", "type": "separator", "orientation": "vertical"},
          {"id": "tb-cut", "type": "button", "text": "Cut", "style": "toolbar", "action": "edit.cut"},
          {"id": "tb-copy", "type": "button", "text": "Copy", "style": "toolbar", "action": "edit.copy"},
          {"id": "tb-paste", "type": "button", "text": "Paste", "style": "toolbar", "action": "edit.paste"},
          {"id": "tb-sep-2", "type": "separator", "orientation": "vertical"},
          {"id": "tb-find", "type": "button", "text": "Find", "style": "toolbar", "icon": "search", "action": "search.find"},
          {"id": "tb-wrap", "type": "button", "text": "Wrap", "style": "toolbar", "active": true, "action": "view.wrap"},
          {"id": "tb-spacer", "type": "spacer", "flex": 1},
          {"id": "tb-settings", "type": "button", "text": "Settings", "style": "toolbar", "icon": "settings", "action": "app.settings"}
        ]
      },
      {
        "id": "docs",
        "type": "tabs",
        "height": 34,
        "background": "#e9edf2",
        "items": [
          {"label": "welcome.py", "action": "doc.welcome"},
          {"label": "notes.txt", "action": "doc.notes", "active": true, "dirty": true},
          {"label": "config.json", "action": "doc.config"}
        ]
      },
      {
        "id": "editor-frame",
        "type": "row",
        "spacing": 0,
        "padding": 0,
        "flex": 1,
        "background": "#ffffff",
        "border": "#c9ced6",
        "children": [
          {
            "id": "editor",
            "type": "textArea",
            "flex": 1,
            "text": "Aurora Host workbench\n\nThis scene is rendered by the generic host, not by the Aurora demo shell.\nThe application owns the document and supplies labels, menus and tab data.\n\nTODO\n  [x] menu bar with nested submenus\n  [x] toolbar with icon buttons\n  [x] document tabs with dirty state\n  [x] right-click context menu\n  [ ] your next desktop application\n\nSearch: menu, toolbar, tab, context\nLine 11, column 1",
            "menu": [
              {"label": "Undo", "shortcut": "Ctrl+Z", "action": "edit.undo"},
              {"label": "Redo", "shortcut": "Ctrl+Y", "action": "edit.redo"},
              {"separator": true},
              {"label": "Cut", "shortcut": "Ctrl+X", "action": "edit.cut"},
              {"label": "Copy", "shortcut": "Ctrl+C", "action": "edit.copy"},
              {"label": "Paste", "shortcut": "Ctrl+V", "action": "edit.paste"},
              {"separator": true},
              {"label": "Select All", "shortcut": "Ctrl+A", "action": "edit.selectAll"},
              {"separator": true},
              {"label": "Find...", "shortcut": "Ctrl+F", "icon": "search", "action": "search.find"}
            ]
          }
        ]
      },
      {
        "id": "statusbar",
        "type": "row",
        "height": 25,
        "spacing": 6,
        "padding": 3,
        "background": "#eef1f5",
        "border": "#d0d4da",
        "children": [
          {"id": "status-position", "type": "label", "text": "Ln 1, Col 1", "scale": 1, "fontSize": 12, "textColor": "#4b5563"},
          {"id": "status-spacer", "type": "spacer", "flex": 1},
          {"id": "status-encoding", "type": "label", "text": "UTF-8", "scale": 1, "fontSize": 12, "textColor": "#4b5563"},
          {"id": "status-eol", "type": "label", "text": "Windows (CRLF)", "scale": 1, "fontSize": 12, "textColor": "#4b5563"},
          {"id": "status-mode", "type": "label", "text": "INS", "scale": 1, "fontSize": 12, "textColor": "#4b5563"},
          {"id": "status-message", "type": "label", "text": "Ready", "scale": 1, "fontSize": 12, "textColor": "#2563eb"}
        ]
      }
    ]
  }
}
