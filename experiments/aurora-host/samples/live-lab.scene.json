                        "x2": 408,
                        "y2": 304,
                        "color": "#172033",
                        "thickness": 1
                      },
                      {
                        "op": "line",
                        "x": 464,
                        "y": 16,
                        "x2": 464,
                        "y2": 304,
                        "color": "#172033",
                        "thickness": 1
                      },
                      {
                        "op": "line",
                        "x": 520,
                        "y": 16,
