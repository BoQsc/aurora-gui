                        "y2": 304,
                        "color": "#172033",
                        "thickness": 1
                      },
                      {
                        "op": "line",
                        "x": 16,
                        "y": 64,
                        "x2": 592,
                        "y2": 64,
                        "color": "#172033",
                        "thickness": 1
                      },
                      {
                        "op": "line",
                        "x": 16,
                        "y": 112,
                        "x2": 592,
                        "y2": 112,
                        "color": "#172033",
