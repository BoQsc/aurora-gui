                        "radius": 30,
                        "color": "#38bdf8"
                      },
                      {
                        "op": "line",
                        "x": 96,
                        "y": 160,
                        "x2": 210,
                        "y2": 160,
                        "color": "#334155",
                        "thickness": 2
                      },
                      {
                        "op": "line",
                        "x": 398,
                        "y": 160,
                        "x2": 512,
                        "y2": 160,
                        "color": "#334155",
                        "thickness": 2
                      },
                      {
                        "op": "text",
                        "x": 244,
                        "y": 272,
                        "text": "LIVE PREVIEW",
                        "color": "#64748b",
                        "scale": 2
                      },
                      {
                        "op": "text",
                        "x": 24,
                        "y": 288,
                        "text": "608 × 320",
                        "color": "#475569",
                        "scale": 1
                      }
                    ]
                  },
                  {
                    "id": "controls",
                    "type": "column",
                    "width": 280,
                    "spacing": 10,
                    "padding": 16,
                    "background": "#0b1220",
                    "border": "#1e293b",
                    "radius": 12,
                    "children": [
                      {
                        "id": "control-kicker",
                        "type": "label",
                        "text": "CONTROL",
                        "scale": 1,
                        "textColor": "#64748b"
                      },
                      {
                        "id": "pulse",
                        "type": "button",
                        "style": "toolbar",
                        "icon": "refresh",
                        "text": "Pulse",
                        "width": 248,
                        "height": 32,
                        "action": "demo.pulse",
                        "tooltip": "Emit a pulse action"
                      },
                      {
                        "id": "add-card",
                        "type": "button",
                        "style": "toolbar",
                        "icon": "new",
                        "text": "Add card",
                        "width": 248,
                        "height": 32,
                        "action": "demo.addCard",
                        "tooltip": "Ask for another card"
                      },
                      {
                        "id": "reset",
                        "type": "button",
                        "style": "toolbar",
                        "icon": "trash",
                        "text": "Reset",
                        "width": 248,
                        "height": 32,
                        "action": "demo.reset",
                        "tooltip": "Ask to reset the scene"
                      },
                      {
                        "id": "command",
                        "type": "textField",
                        "text": "make the heading teal",
                        "width": 248,
                        "height": 34,
                        "tooltip": "Type a change request for Aurora"
                      },
                      {
                        "id": "control-hint",
                        "type": "label",
                        "text": "Actions emit events to the bridge.",
                        "scale": 1,
                        "textColor": "#64748b"
                      }
                    ]
                  }
                ]
              },
              {
                "id": "notes",
                "type": "textArea",
                "text": "Session notes\n- The host owns the window and the scene.\n- Aurora edits the scene file; the window reloads in place.\n- Ask for any visual or layout change.",
                "height": 140,
                "background": "#0b1220",
                "border": "#1e293b",
                "radius": 8,
                "textColor": "#cbd5e1",
                "lineNumbers": true,
                "highlightCurrentLine": true,
                "events": [
                  "change",
                  "cursor"
                ]
              }
            ]
          }
        ]
      },
      {
        "id": "statusbar",
        "type": "row",
        "spacing": 8,
        "padding": 8,
        "height": 34,
        "background": "#0f172a",
        "border": "#1e293b",
        "children": [
          {
            "id": "status",
            "type": "label",
            "text": "Scene reloaded — structural edit applied",
            "scale": 1,
            "textColor": "#94a3b8"
          },
          {
            "type": "spacer",
            "flex": 1
          },
          {
            "id": "status-meta",
            "type": "label",
            "text": "1180 × 800 · dark",
            "scale": 1,
            "align": "right",
            "textColor": "#64748b"
          }
        ]
      }
    ]
  }
}
