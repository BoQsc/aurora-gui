{
  "schemaVersion": 2,
  "window": {
    "title": "Aurora Live Scene Lab",
    "width": 1180,
    "height": 800,
    "theme": "dark"
  },
  "root": {
    "id": "root",
    "type": "column",
    "spacing": 0,
    "padding": 0,
    "background": "#0b1020",
    "children": [
      {
        "id": "titlebar",
        "type": "titleBar",
        "text": "Aurora Live Scene Lab",
        "height": 44,
        "background": "#0f172a",
        "border": "#1e293b",
        "textColor": "#e2e8f0"
      },
      {
        "id": "toolbar",
        "type": "row",
        "spacing": 6,
        "padding": 8,
        "height": 46,
        "background": "#0f172a",
        "border": "#1e293b",
        "children": [
          {
            "id": "view-overview",
            "type": "button",
            "style": "toolbar",
            "icon": "home",
            "text": "Overview",
            "width": 108,
            "height": 28,
            "action": "view.overview",
            "tooltip": "Show the overview panel"
          },
          {
            "id": "view-canvas",
            "type": "button",
            "style": "toolbar",
            "icon": "image",
            "text": "Canvas",
            "width": 100,
            "height": 28,
            "action": "view.canvas",
            "tooltip": "Focus the live canvas"
          },
          {
            "id": "view-editor",
            "type": "button",
            "style": "toolbar",
            "icon": "terminal",
            "text": "Editor",
            "width": 96,
            "height": 28,
            "action": "view.editor",
            "tooltip": "Focus the session notes"
          },
          {
            "id": "view-theme",
            "type": "button",
            "style": "toolbar",
            "text": "Theme",
            "width": 96,
            "height": 28,
            "action": "theme.toggle",
            "tooltip": "Ask for a light or dark theme"
          },
          {
            "type": "separator",
            "orientation": "vertical"
          },
          {
            "id": "live-label",
            "type": "label",
            "text": "LIVE",
            "scale": 1,
            "textColor": "#34d399",
            "tooltip": "Connected to the live scene bridge"
          },
          {
            "type": "spacer",
            "flex": 1
          },
          {
            "id": "frame-label",
            "type": "label",
            "text": "1180 × 800 · dark",
            "scale": 1,
            "align": "right",
            "textColor": "#64748b"
          }
        ]
      },
      {
        "id": "content",
        "type": "row",
        "flex": 1,
        "spacing": 0,
        "padding": 0,
        "children": [
          {
            "id": "sidebar",
            "type": "column",
            "width": 230,
            "spacing": 10,
            "padding": 18,
            "background": "#0b1220",
            "border": "#1e293b",
            "children": [
              {
                "id": "scene-kicker",
                "type": "label",
                "text": "SCENE",
                "scale": 1,
                "textColor": "#64748b"
              },
              {
                "id": "scene-title",
                "type": "label",
                "text": "Aurora Live Lab",
                "scale": 2,
                "textColor": "#e2e8f0"
              },
              {
                "id": "window-meta",
                "type": "label",
                "text": "1180 × 800 · dark",
                "scale": 1,
                "textColor": "#94a3b8"
              },
              {
                "type": "separator",
                "orientation": "horizontal"
              },
              {
                "id": "state-kicker",
                "type": "label",
                "text": "LIVE STATE",
                "scale": 1,
                "textColor": "#64748b"
              },
              {
                "id": "node-count",
                "type": "label",
                "text": "Nodes 47",
                "scale": 1,
                "textColor": "#94a3b8"
              },
              {
                "id": "last-action",
                "type": "label",
                "text": "Scene reloaded",
                "scale": 1,
                "textColor": "#94a3b8"
              },
              {
                "id": "scene-mode",
                "type": "label",
                "text": "Mode idle",
                "scale": 1,
                "textColor": "#94a3b8"
              },
              {
                "type": "spacer",
                "flex": 1
              },
              {
                "id": "live-note",
                "type": "label",
                "text": "This window is real.",
                "scale": 1,
                "textColor": "#34d399"
              },
              {
                "id": "live-hint",
                "type": "label",
                "text": "Ask in chat for any change.",
                "scale": 1,
                "textColor": "#64748b"
              }
            ]
          },
          {
            "id": "main",
            "type": "column",
            "flex": 1,
            "spacing": 14,
            "padding": 24,
            "children": [
              {
                "id": "heading-row",
                "type": "row",
                "spacing": 12,
                "children": [
                  {
                    "id": "heading",
                    "type": "label",
                    "text": "Live Scene Lab · connected",
                    "scale": 4,
                    "textColor": "#2dd4bf"
                  },
                  {
                    "type": "spacer",
                    "flex": 1
                  },
                  {
                    "id": "badge",
                    "type": "label",
                    "text": "LIVE",
                    "scale": 1,
                    "align": "right",
                    "textColor": "#34d399"
                  }
                ]
              },
              {
                "id": "subtitle",
                "type": "label",
                "text": "This window is the canvas. Describe a change and the scene reloads in place.",
                "scale": 1,
                "textColor": "#94a3b8"
              },
              {
                "id": "changelog",
                "type": "row",
                "spacing": 10,
                "padding": 10,
                "background": "#0b1220",
                "border": "#1e293b",
                "radius": 8,
                "children": [
                  {
                    "id": "changelog-kicker",
                    "type": "label",
                    "text": "LIVE EDIT 01",
                    "scale": 1,
                    "textColor": "#34d399"
                  },
                  {
                    "id": "changelog-text",
                    "type": "label",
                    "text": "The heading is teal. This card was added by editing the scene file.",
                    "scale": 1,
                    "textColor": "#94a3b8"
                  }
                ]
              },
              {
                "id": "workbench",
                "type": "row",
                "height": 340,
                "spacing": 14,
                "children": [
                  {
                    "id": "preview",
                    "type": "canvas",
                    "flex": 1,
                    "height": 320,
                    "background": "#0f172a",
                    "border": "#1e293b",
                    "radius": 12,
                    "commands": [
                      {
                        "op": "roundedRect",
                        "x": 16,
                        "y": 16,
                        "width": 576,
                        "height": 288,
                        "radius": 16,
                        "color": "#111c33"
                      },
                      {
