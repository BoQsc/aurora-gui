{
  "inputs": [
    "experiments/aurora-host/protocol",
    "experiments/aurora-host/generated",
    "experiments/aurora-host/source",
    "experiments/aurora-host/tools",
    "experiments/aurora-host/samples",
    "experiments/aurora-host/tests",
    "experiments/aurora-host/dub.json",
    "experiments/aurora-host/README.md",
    "experiments/aurora-host/.gitignore",
    "vendor/aurora-d-0.4.5/source",
    "vendor/aurora-standard/source"
  ],
  "steps": [
    {
      "kind": "compile",
      "command": {
        "program": "dub",
        "args": [
          "build"
        ],
        "workdir": "experiments/aurora-host",
        "timeout": 600000
      }
    },
    {
      "kind": "tests",
      "command": {
        "program": "python",
        "args": [
          "experiments/aurora-host/tools/verify_experiment.py"
        ],
        "workdir": ".",
        "timeout": 600000
      }
    },
    {
      "kind": "prepare",
      "command": {
        "program": "python",
        "args": [
          "-B",
          "tools/ui_depth_test.py",
          "--out-dir",
          "build"
        ],
        "workdir": "experiments/aurora-host",
        "timeout": 120000
      }
    },
    {
      "kind": "render",
      "reference": "experiments/aurora-host/samples/ui-depth-reference.png",
      "actual": "experiments/aurora-host/build/ui-depth.png",
      "referenceSource": "Reviewed baseline of the host workbench: menu bar, icon toolbar, document tabs, editor, and status bar at 1.25x DPI."
    }
  ]
}
