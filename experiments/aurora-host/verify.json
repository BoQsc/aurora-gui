{
  "inputs": [
    "experiments/aurora-host/protocol",
    "experiments/aurora-host/generated",
    "experiments/aurora-host/source",
    "experiments/aurora-host/tools",
    "experiments/aurora-host/samples",
    "experiments/aurora-host/tests",
    "experiments/aurora-host/dub.json",
    "experiments/aurora-host/README.md",
    "experiments/aurora-host/MODULES.md",
    "experiments/aurora-host/.gitignore",
    "vendor/aurora-d-0.4.5/source",
    "vendor/aurora-standard/source"
  ],
  "steps": [
    {
      "kind": "compile",
      "command": {
        "program": "dub",
        "args": [
          "build",
          "--dest=build/verify"
        ],
        "workdir": "experiments/aurora-host",
        "timeout": 600000
      }
    },
    {
      "kind": "tests",
      "command": {
        "program": "python",
        "args": [
          "-B",
          "experiments/aurora-host/tools/verify_experiment.py"
        ],
        "workdir": ".",
        "timeout": 600000
      }
    },
    {
      "kind": "prepare",
      "command": {
        "program": "python",
        "args": [
          "-B",
          "tools/ui_depth_test.py",
          "--out-dir",
          "build",
          "--host",
          "build/verify/aurora-host-experiment.exe"
        ],
        "workdir": "experiments/aurora-host",
        "timeout": 120000
      }
    },
    {
      "kind": "prepare",
      "command": {
        "program": "python",
        "args": [
          "-B",
          "tools/normalize_ui_screenshot.py"
        ],
        "workdir": "experiments/aurora-host",
        "timeout": 120000
      }
    },
    {
      "kind": "render",
      "reference": "experiments/aurora-host/samples/ui-depth-ref1x.png",
      "actual": "experiments/aurora-host/build/ui-depth-1x.png",
      "channelTolerance": 0,
      "maxDifferentPixels": 12544,
      "referenceSource": "Nearest-neighbor 1x projection of the owner-approved natural grayscale hinting C reference (2026-10-20, 125% DPI, 1225x800 pixels, 980x640 logical). The original remains samples/ui-depth-reference.png. The live screenshot is captured at the host display scale and normalized to this 980x640 logical viewport before comparison; up to 2% differing pixels are accepted for DPI-dependent glyph hinting. Previous B reference is preserved in artifacts/native-text-progress/host-B-reference-120dpi.png."
    }
  ]
}
