{
  "name": "aurora-designer",
  "description": "A visual UI designer for building Aurora-D interfaces: drag widgets from a palette, position them on an artboard, edit properties in an inspector, and copy generated D code.",
  "authors": [
    "OpenAI"
  ],
  "copyright": "Copyright \u00a9 2026 OpenAI",
  "license": "BSL-1.0",
  "targetType": "executable",
  "targetName": "aurora-designer",
  "mainSourceFile": "source/app.d",
  "sourcePaths": [
    "source",
    "../vendor/aurora-d-0.4.5/source"
  ],
  "libs-windows": [
    "user32",
    "gdi32",
    "shell32",
    "wininet"
  ],
  "buildTypes": {
    "portable-release": {
      "buildOptions": [
        "releaseMode",
        "optimize",
        "inline"
      ],
      "dflags-windows-dmd": [
        "-mscrtlib=libcmt"
      ],
      "dflags-windows-ldc": [
        "-mscrtlib=libcmt"
      ]
    }
  },
  "lflags-windows": [
    "/SUBSYSTEM:WINDOWS",
    "/ENTRY:mainCRTStartup"
  ],
  "libs-linux": [
    "X11",
    "dl"
  ],
  "lflags-osx": [
    "-framework",
    "AppKit",
    "-framework",
    "CoreGraphics",
    "-framework",
    "CoreFoundation",
    "-framework",
    "QuartzCore",
    "-lobjc"
  ],
  "version": "0.66.7"
}
